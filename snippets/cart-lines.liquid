{% doc %}
Renders cart items using their unique line keys.
@param cart - Shopify cart
{% enddoc %}
{% for item in cart.items %}<article class="cart-line" data-cart-line="{{ item.key | escape }}"><a class="cart-line-image" href="{{ item.url }}">{% if item.image %}{{ item.image | image_url: width: 240 | image_tag: loading: 'lazy', widths: '120, 240', sizes: '100px' }}{% else %}{{ 'product-1' | placeholder_svg_tag: 'placeholder' }}{% endif %}</a><div class="cart-line-info"><h3><a href="{{ item.url }}">{{ item.product.title | escape }}</a></h3>{% unless item.product.has_only_default_variant %}<p>{{ item.variant.title | escape }}</p>{% endunless %}{% if item.selling_plan_allocation %}<p>{{ item.selling_plan_allocation.selling_plan.name | escape }}</p>{% endif %}{% for property in item.properties %}{% assign first_char = property.first | slice: 0 %}{% unless property.last == blank or first_char == '_' %}<p>{{ property.first | escape }}: {{ property.last | escape }}</p>{% endunless %}{% endfor %}<div class="price">{{ item.final_line_price | money }}{% if item.original_line_price != item.final_line_price %}<s>{{ item.original_line_price | money }}</s>{% endif %}</div>{% if item.unit_price_measurement %}<small>{{ 'cart.unit_price' | t }}: {{ item.unit_price | money }} / {{ item.unit_price_measurement.reference_value }}{{ item.unit_price_measurement.reference_unit }}</small>{% endif %}{% for discount in item.line_level_discount_allocations %}<small class="cart-discount">{{ discount.discount_application.title | escape }} (−{{ discount.amount | money }})</small>{% endfor %}<div class="cart-line-controls"><div class="quantity-picker"><button type="button" data-cart-delta="-1" aria-label="{{ 'general.decrease' | t }}">{% render 'icon', name: 'minus' %}</button><input type="number" name="updates[]" value="{{ item.quantity }}" min="0" step="{{ item.variant.quantity_rule.increment | default: 1 }}" data-cart-quantity aria-label="{{ 'product.quantity' | t }} {{ item.product.title | escape }}"><button type="button" data-cart-delta="1" aria-label="{{ 'general.increase' | t }}">{% render 'icon', name: 'plus' %}</button></div><a href="{{ item.url_to_remove }}" class="text-link" data-cart-remove>{{ 'cart.remove' | t }}</a></div></div></article>{% endfor %}
