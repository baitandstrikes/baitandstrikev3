{% doc %}
Renders a product card with quick view.
@param {product} product - Product
{% enddoc %}
<article class="product-card" data-fishing-card data-fishing-brand="{{ product.vendor | escape }}" data-fishing-options="{{ product.options | json | escape }}" data-fishing-variants="{{ product.variants | map: 'options' | json | escape }}"><div class="card-media"><a href="{{ product.url }}" tabindex="-1" aria-hidden="true">{% if product.featured_image %}{{ product.featured_image | image_url: width: 700 | image_tag: class: 'card-primary', loading: 'lazy', widths: '200, 350, 500, 700', sizes: '(min-width: 990px) 25vw, 50vw' }}{% if product.images.size > 1 %}{{ product.images[1] | image_url: width: 700 | image_tag: class: 'card-secondary', loading: 'lazy', widths: '200, 350, 500, 700', sizes: '(min-width: 990px) 25vw, 50vw' }}{% endif %}{% else %}{{ 'product-1' | placeholder_svg_tag: 'placeholder' }}{% endif %}</a>{% unless product.available %}<span class="badge">{{ 'product.sold_out' | t }}</span>{% else %}{% if product.compare_at_price > product.price %}<span class="badge sale">{{ 'product.sale' | t }}</span>{% endif %}{% endunless %}<a href="{{ product.url }}" class="quick-view-button" data-quick-view="{{ product.url }}">{{ 'product.quick_view' | t }}</a></div><div class="card-info">{% if product.vendor != blank %}<p class="card-vendor">{{ product.vendor | escape }}</p>{% endif %}<h3><a href="{{ product.url }}">{{ product.title | escape }}</a></h3>{% render 'price', product: product %}<div class="card-specs">{% unless product.has_only_default_variant %}{% for option in product.options_with_values limit: 2 %}<p><span>{{ option.name | escape }}:</span> {% for value in option.values limit: 3 %}{{ value.name | default: value | escape }}{% unless forloop.last %} / {% endunless %}{% endfor %}{% if option.values.size > 3 %} +{{ option.values.size | minus: 3 }}{% endif %}</p>{% endfor %}{% endunless %}</div><p class="card-availability{% unless product.available %} is-sold-out{% endunless %}">{% if product.available %}{{ 'discovery.ready' | t }}{% else %}{{ 'product.sold_out' | t }}{% endif %}{% unless product.has_only_default_variant %} · {{ 'discovery.variants' | t: count: product.variants.size }}{% endunless %}</p><div class="card-swatches">{% for option in product.options_with_values %}{% for value in option.values %}{% if value.swatch != blank %}{% assign option_index = option.position | minus: 1 %}{% assign swatch_variant = nil %}{% for candidate in product.variants %}{% if candidate.options[option_index] == value.name %}{% assign swatch_variant = candidate %}{% if candidate.available %}{% break %}{% endif %}{% endif %}{% endfor %}<a class="card-swatch" href="{{ value.product_url | default: product.url }}{% if value.product_url == blank and swatch_variant %}?variant={{ swatch_variant.id }}{% endif %}" aria-label="{{ value.name | escape }}"{% if value.swatch.color %} style="--swatch:{{ value.swatch.color }}"{% endif %}>{% if value.swatch.image %}{{ value.swatch.image | image_url: width: 50 | image_tag: loading: 'lazy' }}{% endif %}</a>{% endif %}{% endfor %}{% endfor %}</div></div></article>
