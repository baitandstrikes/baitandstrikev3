{% doc %}
Renders a product card with quick view.
@param {product} product - Product
{% enddoc %}
<article class="product-card"><div class="card-media"><a href="{{ product.url }}" tabindex="-1" aria-hidden="true">{% if product.featured_image %}{{ product.featured_image | image_url: width: 700 | image_tag: class: 'card-primary', loading: 'lazy', widths: '200, 350, 500, 700', sizes: '(min-width: 990px) 25vw, 50vw' }}{% if product.images.size > 1 %}{{ product.images[1] | image_url: width: 700 | image_tag: class: 'card-secondary', loading: 'lazy', widths: '200, 350, 500, 700', sizes: '(min-width: 990px) 25vw, 50vw' }}{% endif %}{% else %}{{ 'product-1' | placeholder_svg_tag: 'placeholder' }}{% endif %}</a>{% unless product.available %}<span class="badge">{{ 'product.sold_out' | t }}</span>{% else %}{% if product.compare_at_price > product.price %}<span class="badge sale">{{ 'product.sale' | t }}</span>{% endif %}{% endunless %}<a href="{{ product.url }}" class="quick-view-button" data-quick-view="{{ product.url }}">{{ 'product.quick_view' | t }}</a></div><div class="card-info">{% if product.vendor != blank %}<p class="card-vendor">{{ product.vendor | escape }}</p>{% endif %}<h3><a href="{{ product.url }}">{{ product.title | escape }}</a></h3>{% render 'price', product: product %}</div></article>
