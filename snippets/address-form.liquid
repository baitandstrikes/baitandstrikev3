{% doc %}
Renders address fields within a customer_address form.
@param {form} form - Form object
@param {string} suffix - Unique identifier
{% enddoc %}
<label for="Address-first_name-{{ suffix }}">{{ 'customer.first_name' | t }}</label><input id="Address-first_name-{{ suffix }}" name="address[first_name]" value="{{ form.first_name | escape }}" autocomplete="given-name" required><label for="Address-last_name-{{ suffix }}">{{ 'customer.last_name' | t }}</label><input id="Address-last_name-{{ suffix }}" name="address[last_name]" value="{{ form.last_name | escape }}" autocomplete="family-name"><label for="Address-company-{{ suffix }}">{{ 'customer.company' | t }}</label><input id="Address-company-{{ suffix }}" name="address[company]" value="{{ form.company | escape }}" autocomplete="organization"><label for="Address-address1-{{ suffix }}">{{ 'customer.address1' | t }}</label><input id="Address-address1-{{ suffix }}" name="address[address1]" value="{{ form.address1 | escape }}" autocomplete="address-line1" required><label for="Address-address2-{{ suffix }}">{{ 'customer.address2' | t }}</label><input id="Address-address2-{{ suffix }}" name="address[address2]" value="{{ form.address2 | escape }}" autocomplete="address-line2"><label for="Address-city-{{ suffix }}">{{ 'customer.city' | t }}</label><input id="Address-city-{{ suffix }}" name="address[city]" value="{{ form.city | escape }}" autocomplete="address-level2" required><label for="Address-zip-{{ suffix }}">{{ 'customer.zip' | t }}</label><input id="Address-zip-{{ suffix }}" name="address[zip]" value="{{ form.zip | escape }}" autocomplete="postal-code"><label for="Country-{{ suffix }}">{{ 'customer.country' | t }}</label><select id="Country-{{ suffix }}" name="address[country]" data-country data-default="{{ form.country | escape }}" data-province="Province-{{ suffix }}">{{ all_country_option_tags }}</select><div data-province-wrapper><label for="Province-{{ suffix }}">{{ 'customer.province' | t }}</label><select id="Province-{{ suffix }}" name="address[province]" data-default="{{ form.province | escape }}"></select></div><label for="Phone-{{ suffix }}">{{ 'general.phone' | t }}</label><input id="Phone-{{ suffix }}" name="address[phone]" type="tel" value="{{ form.phone | escape }}" autocomplete="tel"><label class="checkbox">{{ form.set_as_default_checkbox }} {{ 'customer.default' | t }}</label><button class="button">{{ 'customer.save' | t }}</button>
