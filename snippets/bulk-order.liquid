{% doc %}
Orders multiple variants using the current buyer's contextual rules and prices.
@param {product} product - Product to order
@param {string} section_id - Product section identifier
{% enddoc %}
{% if product.variants.size > 1 %}<details class="product-accordion"><summary>{{ 'b2b.bulk' | t }}{% render 'icon', name: 'plus' %}</summary><form action="{{ routes.cart_add_url }}" method="post" data-bulk-order><div class="table-scroll">{% paginate product.variants by 50 %}<table><thead><tr><th>{{ 'b2b.variant' | t }}</th><th>{{ 'b2b.price' | t }}</th><th>{{ 'b2b.quantity' | t }}</th></tr></thead><tbody>{% for variant in product.variants %}<tr><td><label for="Bulk-{{ section_id }}-{{ variant.id }}">{{ variant.title | escape }}</label>{% if variant.sku != blank %}<small>{{ variant.sku | escape }}</small>{% endif %}<small>{{ 'b2b.rules' | t: min: variant.quantity_rule.min, step: variant.quantity_rule.increment }}</small>{% if variant.quantity_rule.max %}<small>{{ 'b2b.max' | t: max: variant.quantity_rule.max }}</small>{% endif %}</td><td>{{ variant.price | money }}{% for price_break in variant.quantity_price_breaks %}<small>{{ price_break.minimum_quantity }}+ : {{ price_break.price | money }}</small>{% endfor %}</td><td><input id="Bulk-{{ section_id }}-{{ variant.id }}" type="number" name="items[{{ forloop.index0 }}][quantity]" value="0" min="0" step="1" inputmode="numeric" data-bulk-quantity data-variant="{{ variant.id }}" data-min="{{ variant.quantity_rule.min | default: 1 }}" data-step="{{ variant.quantity_rule.increment | default: 1 }}"{% if variant.quantity_rule.max %} data-max="{{ variant.quantity_rule.max }}"{% endif %}{% unless variant.available %} disabled aria-label="{{ 'product.sold_out' | t }} {{ variant.title | escape }}"{% endunless %}><input type="hidden" name="items[{{ forloop.index0 }}][id]" value="{{ variant.id }}"{% unless variant.available %} disabled{% endunless %}></td></tr>{% endfor %}</tbody></table><div class="pagination">{{ paginate | default_pagination }}</div>{% endpaginate %}</div><p class="form-error" data-bulk-error role="alert" hidden></p><button class="button" type="submit">{{ 'b2b.add' | t }}</button><a class="text-link" href="{{ routes.cart_url }}" data-open-cart>{{ 'cart.title' | t }}</a></form></details>{% endif %}
