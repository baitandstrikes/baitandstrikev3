{% doc %}
Renders Shopify price and comparison price.
@param {product} product - Product
@param {variant} [variant] - Selected variant
{% enddoc %}
{% assign price_variant = variant %}{% if price_variant == blank %}{% assign sorted_variants = product.variants | sort: 'price' %}{% assign price_variant = sorted_variants | first %}{% endif %}{% assign price = price_variant.price | default: product.price %}{% assign compare = price_variant.compare_at_price %}<div class="price">{% if variant == blank and product.price_varies %}<span>{{ 'product.from' | t }} </span>{% endif %}<span class="price-current">{% render 'money-without-cents', amount: price %}</span>{% if compare > price %}<s>{% render 'money-without-cents', amount: compare %}</s>{% endif %}</div>
