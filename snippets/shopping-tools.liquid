{% doc %}
Saved products, comparison table and merchant contact quote request.
{% enddoc %}
<dialog id="ShoppingTools" class="shopping-dialog" aria-labelledby="ShoppingToolsTitle">
<button type="button" class="icon-button dialog-close" data-close-dialog aria-label="{{ 'general.close' | t }}">{% render 'icon', name: 'close' %}</button>
<h2 id="ShoppingToolsTitle">{{ 'tools.wishlist' | t }}</h2>
<nav class="shopping-tabs" aria-label="{{ 'tools.menu' | t }}"><button type="button" class="text-link" data-tools-open="wishlist">{{ 'tools.wishlist' | t }} (<span data-tools-count="wishlist">0</span>)</button><button type="button" class="text-link" data-tools-open="compare">{{ 'tools.compare' | t }} (<span data-tools-count="compare">0</span>)</button></nav>
<p data-tools-status role="status" aria-live="polite"></p><p data-tools-error role="alert" hidden></p><button type="button" class="text-link" data-tools-retry hidden>{{ 'tools.retry' | t }}</button>
<div data-tools-content></div>
<div data-quote-form hidden>
<p>{{ 'tools.quote_note' | t }}</p>
{% form 'contact', id: 'WholesaleQuoteForm' %}
{% if form.posted_successfully? %}<p role="status" data-quote-success>{{ 'tools.sent' | t }}</p>{% endif %}
{% if form.errors %}<div role="alert" data-quote-errors>{{ form.errors | default_errors }}</div>{% endif %}
<input type="hidden" name="contact[request_type]" value="{{ 'tools.quote' | t }}">
<label for="QuoteName">{{ 'general.name' | t }}</label><input id="QuoteName" name="contact[name]" autocomplete="name" value="{{ form.name | default: customer.name | escape }}" required maxlength="120">
<label for="QuoteEmail">{{ 'general.email' | t }}</label><input id="QuoteEmail" type="email" name="contact[email]" autocomplete="email" value="{{ form.email | default: customer.email | escape }}" required>
<label for="QuoteCompany">{{ 'tools.company' | t }}</label><input id="QuoteCompany" name="contact[company]" value="{{ customer.current_company.name | escape }}" autocomplete="organization" required maxlength="160">
<label for="QuotePhone">{{ 'general.phone' | t }}</label><input id="QuotePhone" name="contact[phone]" type="tel" autocomplete="tel" required maxlength="40">
<label for="QuoteBody">{{ 'tools.summary' | t }}</label><textarea id="QuoteBody" name="contact[body]" rows="8" required readonly>{{ form.body | escape }}</textarea>
<label for="QuoteNotes">{{ 'tools.notes' | t }}</label><textarea id="QuoteNotes" name="contact[notes]" rows="3" maxlength="2000"></textarea>
<button class="button" type="submit" data-quote-submit disabled>{{ 'tools.send' | t }}</button>
{% endform %}
</div></dialog>
<div class="shopping-shortcuts wrap" aria-label="{{ 'tools.menu' | t }}"><button type="button" class="text-link" data-tools-open="wishlist">{% render 'icon', name: 'heart' %} {{ 'tools.wishlist' | t }} (<span data-tools-count="wishlist">0</span>)</button><button type="button" class="text-link" data-tools-open="compare">{{ 'tools.compare' | t }} (<span data-tools-count="compare">0</span>)</button></div>
<script type="application/json" id="shopping-tools-labels">{
{% assign keys = 'view_price,quantity_label,wishlist,compare,quote,save,saved,remove,empty,loading,error,retry,limit,compare_hint,variant,brand,price,stock,ready,sold_out,unavailable,quantity,quote_add,quote_note,storage_note,not_available,summary,product,sku,loading_quote,length,action,line_weight,pe,ratio,drag,diameter,size,weight,category,rod,reel,line,other,added' | split: ',' %}{% for key in keys %}{% unless forloop.first %},{% endunless %}{{ key | json }}:{% assign translation = 'tools.' | append: key %}{{ translation | t | json }}{% endfor %}}</script>
