{% doc %}
Renders an interface icon.
@param {string} name - Icon name
{% enddoc %}
<svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {% case name %}
    {% when 'heart' %}<path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1.1-1.1a5.5 5.5 0 0 0-7.8 7.8L12 21l8.8-8.6a5.5 5.5 0 0 0 0-7.8Z"/>
    {% when 'compare' %}<path d="M5 20V10M12 20V4M19 20v-7M2 20h20"/>
    {% when 'compare-vs' %}<text x="12" y="12" fill="currentColor" stroke="none" font-size="9" font-weight="700" text-anchor="middle" dominant-baseline="central" font-family="Arial, sans-serif">VS</text>
    {% when 'search' %}<circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 5 5"/>
    {% when 'account' %}<circle cx="12" cy="7" r="4"/><path d="M4 22v-3a8 8 0 0 1 16 0v3Z"/>
    {% when 'bag' %}<path d="M5 7h14l1 15H4L5 7Z"/><path d="M8 8V6a4 4 0 0 1 8 0v2"/>
    {% when 'menu' %}<path d="M3 6h18M3 12h18M3 18h18"/>
    {% when 'close' %}<path d="m5 5 14 14M19 5 5 19"/>
    {% when 'arrow' %}<path d="M4 12h16m-6-6 6 6-6 6"/>
    {% when 'chevron' %}<path d="m6 9 6 6 6-6"/>
    {% when 'plus' %}<path d="M12 4v16M4 12h16"/>
    {% when 'minus' %}<path d="M4 12h16"/>
    {% when 'check' %}<path d="m4 12 5 5L20 6"/>
    {% when 'handshake' %}<path d="m2.5 9 4-3h3l2.5 2 2.5-2h3l4 3-3.5 8-3-1-3 2-3-2-3 1-3.5-8Z"/><path d="m6.5 6 2 8 3.5-2 3.5 2 2-8M9.5 6l2.5 2 2.5-2"/>
    {% when 'fishing' %}<path d="M3 12c2.5-4 7.5-5 12-2l5-3v10l-5-3c-4.5 3-9.5 2-12-2Z"/><circle cx="9" cy="11" r=".6"/>
    {% when 'package' %}<path d="m3 7 9-4 9 4v10l-9 4-9-4V7Z"/><path d="m3 7 9 4 9-4M12 11v10M8 5l9 4"/>
    {% when 'star' %}<path d="m12 3 2.8 5.7 6.2.9-4.5 4.4 1.1 6.2-5.6-3-5.6 3 1.1-6.2L3 9.6l6.2-.9L12 3Z"/>
    {% when 'play' %}<path d="m8 5 11 7-11 7V5Z" fill="currentColor" stroke="none"/>
    {% when 'pause' %}<path d="M8 5v14M16 5v14" stroke-width="3"/>
    {% when 'instagram' %}<rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><path d="M17 6h.01"/>
    {% when 'youtube' %}<rect x="2" y="5" width="20" height="14" rx="4"/><path d="m10 9 5 3-5 3Z"/>
    {% when 'facebook' %}<path d="M14 22V12h4l1-4h-5V6c0-2 1-3 4-3V0h-3c-4 0-6 2-6 6v2H6v4h3v10"/>
    {% when 'tiktok' %}<path d="M14 3v12a5 5 0 1 1-5-5v4a1 1 0 1 0 1 1V3h4c0 4 3 6 6 6V5c-2 0-3-1-3-2"/>
    {% when 'truck' %}<path d="M2 5h12v12H2ZM14 9h5l3 5v3h-8"/><circle cx="6" cy="18" r="2"/><circle cx="18" cy="18" r="2"/>
    {% when 'tag' %}<path d="M3 3h8l10 10-8 8L3 11V3Z"/><circle cx="7.5" cy="7.5" r="1"/>
    {% when 'shield' %}<path d="m12 2 9 4v6c0 5-9 10-9 10S3 17 3 12V6l9-4Z"/><path d="m8 12 3 3 5-6"/>
  {% endcase %}
</svg>
