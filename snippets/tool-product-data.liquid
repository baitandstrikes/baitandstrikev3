{% doc %}
Contextual product data for shopping tools.
@param {product} product - Product
{% enddoc %}
<script type="application/json" data-tool-product>{"handle":{{ product.handle | json }},"title":{{ product.title | json }},"vendor":{{ product.vendor | json }},"url":{{ product.url | json }},"description":{{ product.description | json }},"options":{{ product.options | json }},"image":{% if product.featured_image %}{{ product.featured_image | image_url: width: 360 | json }}{% else %}null{% endif %},"variants":[{% for variant in product.variants %}{% unless forloop.first %},{% endunless %}{"id":{{ variant.id | append: '' | json }},"title":{{ variant.title | json }},"sku":{{ variant.sku | json }},"options":{{ variant.options | json }},"available":{{ variant.available | json }},"min":{{ variant.quantity_rule.min | default: 1 | json }},"increment":{{ variant.quantity_rule.increment | default: 1 | json }},"max":{{ variant.quantity_rule.max | json }}}{% endfor %}]}</script>
