<section class="bns-howto section reveal" aria-labelledby="BNSHowToTitle-{{ section.id }}">
  <div class="wrap">
    <div class="bns-howto__grid">
      <article class="bns-howto__card bns-howto__card--seller">
        <div class="bns-howto__icon" aria-hidden="true">{% render 'icon', name: 'handshake' %}</div>
        <p class="eyebrow">{{ section.settings.sell_eyebrow | escape }}</p>
        <h3 id="BNSHowToTitle-{{ section.id }}">{{ section.settings.sell_title | escape }}</h3>
        <div class="rte">{{ section.settings.sell_text }}</div>
        <ol class="bns-howto__steps">
          {% assign seller_index = 0 %}
          {% for block in section.blocks %}
            {% if block.type == 'sell_step' %}
              {% assign seller_index = seller_index | plus: 1 %}
              <li {{ block.shopify_attributes }}><span>{{ seller_index }}</span><div><strong>{{ block.settings.title | escape }}</strong><p>{{ block.settings.text | escape }}</p></div></li>
            {% endif %}
          {% endfor %}
        </ol>
        {% if section.settings.sell_button_label != blank %}<a class="button" href="{{ section.settings.sell_link | default: '/pages/wholesale-registration-form' }}">{{ section.settings.sell_button_label | escape }}</a>{% endif %}
      </article>
    </div>
  </div>
</section>
{% stylesheet %}
.bns-howto{padding:clamp(48px,7vw,92px) 0;background:#f5f8fa;color:#17232b}
.bns-howto__heading{max-width:760px;margin:0 auto 38px;text-align:center}
.bns-howto__heading h2{font-size:clamp(30px,4vw,48px);line-height:1.12;margin:8px 0 16px}
.bns-howto__heading .rte{color:#586874}
.bns-howto__grid{display:grid;grid-template-columns:minmax(0,760px);justify-content:center}
.bns-howto__card{padding:clamp(24px,3vw,40px);border:1px solid #dce6eb;border-radius:18px;background:#fff;box-shadow:0 12px 34px #17374a0b;transition:transform .55s cubic-bezier(.22,.61,.36,1),box-shadow .55s}
.bns-howto__card:hover{transform:translateY(-5px);box-shadow:0 20px 44px #17374a16}
.bns-howto__card--seller{border-top:4px solid #3282c0}
.bns-howto__icon{width:54px;height:54px;display:grid;place-items:center;border-radius:15px;background:#e8f3fb;font-size:27px;margin-bottom:22px}
.bns-howto__card h3{font-size:clamp(23px,2.5vw,32px);margin:6px 0 14px;line-height:1.2}
.bns-howto__card>.rte{color:#586874;margin-bottom:22px}
.bns-howto__steps{list-style:none;padding:0;margin:0 0 28px;display:grid;gap:18px}
.bns-howto__steps li{display:flex;align-items:flex-start;gap:13px}
.bns-howto__steps li>span{flex:0 0 30px;height:30px;border-radius:50%;display:grid;place-items:center;background:#3282c0;color:#fff;font-size:13px;font-weight:700}
.bns-howto__steps strong{display:block;margin:2px 0 4px}
.bns-howto__steps p{margin:0;color:#61717c;font-size:14px;line-height:1.6}
@media(max-width:749px){.bns-howto__grid{grid-template-columns:minmax(0,1fr)}.bns-howto__card{padding:24px;border-radius:14px}}
@media(prefers-reduced-motion:reduce){.bns-howto__card{transition:none}}
{% endstylesheet %}
{% schema %}
{
  "name": "Cara Membeli & Menjual",
  "settings": [
    {"type":"text","id":"eyebrow","label":"Label kecil","default":"MULAI DI BAIT&STRIKE"},
    {"type":"text","id":"title","label":"Judul","default":"Mau belanja atau jadi mitra?"},
    {"type":"richtext","id":"intro","label":"Pengantar","default":"<p>Pilih jalur yang sesuai kebutuhanmu. Belanja untuk trip berikutnya atau kembangkan bisnis perlengkapan pancing bersama kami.</p>"},
    {"type":"text","id":"buy_eyebrow","label":"Label Cara Membeli","default":"UNTUK PEMANCING"},
    {"type":"text","id":"buy_title","label":"Judul Cara Membeli","default":"Cara Membeli"},
    {"type":"richtext","id":"buy_text","label":"Deskripsi Cara Membeli","default":"<p>Temukan perlengkapan yang cocok untuk target ikan, teknik, dan budget kamu.</p>"},
    {"type":"text","id":"buy_button_label","label":"Tombol Cara Membeli","default":"Jelajahi Produk"},
    {"type":"url","id":"buy_link","label":"Link Cara Membeli"},
    {"type":"text","id":"sell_eyebrow","label":"Label Cara Menjual","default":"UNTUK RESELLER & TOKO"},
    {"type":"text","id":"sell_title","label":"Judul Cara Menjual","default":"Cara Menjadi Mitra"},
    {"type":"richtext","id":"sell_text","label":"Deskripsi Cara Menjual","default":"<p>Punya toko atau ingin menjual perlengkapan BAIT&STRIKE? Mulai dengan mendaftarkan minat sebagai mitra bisnis.</p>"},
    {"type":"text","id":"sell_button_label","label":"Tombol Cara Menjual","default":"Daftar Jadi Mitra"},
    {"type":"url","id":"sell_link","label":"Link Cara Menjual"}
  ],
  "blocks":[
    {"type":"buy_step","name":"Langkah Membeli","settings":[{"type":"text","id":"title","label":"Judul","default":"Pilih perlengkapan"},{"type":"text","id":"text","label":"Deskripsi","default":"Jelajahi koleksi dan baca detail produk serta varian."}]},
    {"type":"sell_step","name":"Langkah Menjadi Mitra","settings":[{"type":"text","id":"title","label":"Judul","default":"Ajukan pendaftaran"},{"type":"text","id":"text","label":"Deskripsi","default":"Isi formulir mitra dengan informasi usaha dan kontak yang bisa dihubungi."}]}
  ],
  "presets":[
    {"name":"Cara Membeli & Menjual","blocks":[
      {"type":"buy_step","settings":{"title":"Pilih produk","text":"Jelajahi katalog dan pilih perlengkapan sesuai kebutuhan."}},
      {"type":"buy_step","settings":{"title":"Cek varian & detail","text":"Periksa spesifikasi, pilihan varian, dan ketersediaan produk."}},
      {"type":"buy_step","settings":{"title":"Checkout","text":"Masukkan produk ke keranjang dan lanjutkan proses pemesanan."}},
      {"type":"sell_step","settings":{"title":"Daftar sebagai mitra","text":"Isi formulir pendaftaran dengan data usaha dan kontak."}},
      {"type":"sell_step","settings":{"title":"Tim kami meninjau","text":"Tim BAIT&STRIKE akan meninjau informasi yang kamu kirim."}},
      {"type":"sell_step","settings":{"title":"Mulai berkolaborasi","text":"Setelah dihubungi tim kami, diskusikan kebutuhan dan peluang kerja sama."}}
    ]}
  ]
}
{% endschema %}