<section class="section wrap" data-recommendations data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit=4&intent=related">{% if recommendations.performed and recommendations.products_count > 0 %}<div class="section-heading"><h2>{{ 'product.recommendations' | t }}</h2></div><div class="product-grid">{% for product in recommendations.products %}{% render 'product-card', product: product %}{% endfor %}</div>{% endif %}</section>
{% schema %}
{
  "name": "Product Recommendations",
  "settings": []
}
{% endschema %}
