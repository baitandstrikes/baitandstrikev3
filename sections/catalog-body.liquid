{% doc %}Dense product catalogue body inspired by industrial marketplace navigation.{% enddoc %}
<section class="catalog-body" aria-label="{{ section.settings.heading | escape }}">
  <div class="wrap catalog-body__inner">
    <header class="catalog-body__header">
      <h2>{{ section.settings.heading | escape }}</h2>
      {% if section.settings.text != blank %}<p>{{ section.settings.text | escape }}</p>{% endif %}
    </header>

    <div class="catalog-body__categories">
      {% for block in section.blocks %}{% if block.type == 'category' %}
        {% assign category_collection = block.settings.collection %}
        <a class="catalog-category" href="{{ category_collection.url | default: routes.all_products_collection_url }}" {{ block.shopify_attributes }}>
          <span class="catalog-category__image">
            {% if block.settings.image %}{{ block.settings.image | image_url: width: 240 | image_tag: loading: 'lazy', widths: '90, 140, 240', sizes: '110px', alt: block.settings.title }}{% elsif block.settings.asset != blank %}<img src="{{ block.settings.asset | asset_url }}" width="160" height="130" loading="lazy" alt="{{ block.settings.title | escape }}">{% endif %}
          </span>
          <strong>{{ block.settings.title | escape }}</strong>
          <span>{{ category_collection.products_count | default: 0 }} produk</span>
        </a>
      {% endif %}{% endfor %}
    </div>

    <div class="catalog-brands">
      <div class="catalog-brands__label"><strong>{{ section.settings.brand_heading | escape }}</strong><a href="#shop-by-brand">Lihat semua</a></div>
      <div class="catalog-brands__list">
        {% for block in section.blocks %}{% if block.type == 'brand' %}
          <a href="{{ routes.collections_url }}/vendors?q={{ block.settings.vendor | url_encode }}" aria-label="{{ block.settings.vendor | escape }}" {{ block.shopify_attributes }}>
            {% if block.settings.image %}{{ block.settings.image | image_url: width: 260 | image_tag: loading: 'lazy', widths: '100, 180, 260', sizes: '130px', alt: block.settings.vendor }}{% else %}<strong>{{ block.settings.vendor | escape }}</strong>{% endif %}
          </a>
        {% endif %}{% endfor %}
      </div>
    </div>

    <div class="catalog-groups">
      {% for block in section.blocks %}{% if block.type == 'category' %}
        {% assign category_collection = block.settings.collection %}
        <article class="catalog-group" {{ block.shopify_attributes }}>
          <header class="catalog-group__heading">
            <span class="catalog-group__thumb">{% if block.settings.image %}{{ block.settings.image | image_url: width: 120 | image_tag: loading: 'lazy', width: 64, alt: block.settings.title }}{% elsif block.settings.asset != blank %}<img src="{{ block.settings.asset | asset_url }}" width="64" height="54" loading="lazy" alt="">{% endif %}</span>
            <div><h3>{{ block.settings.title | escape }}</h3><span>{{ category_collection.products_count | default: 0 }} produk tersedia</span></div>
            <a href="{{ category_collection.url | default: routes.all_products_collection_url }}">Lihat semua →</a>
          </header>
          <div class="catalog-group__content">
            <a class="catalog-group__feature" href="{{ category_collection.url | default: routes.all_products_collection_url }}">
              <span class="catalog-group__feature-image">{% if block.settings.image %}{{ block.settings.image | image_url: width: 300 | image_tag: loading: 'lazy', widths: '140, 220, 300', sizes: '160px', alt: block.settings.title }}{% elsif block.settings.asset != blank %}<img src="{{ block.settings.asset | asset_url }}" width="180" height="150" loading="lazy" alt="{{ block.settings.title | escape }}">{% endif %}</span>
              <strong>{{ block.settings.title | escape }}</strong><span>Jelajahi koleksi</span>
            </a>
            <div class="catalog-group__products">
              {% for product in category_collection.products limit: 8 %}
                <a href="{{ product.url }}">
                  <span>{% if product.featured_image %}{{ product.featured_image | image_url: width: 160 | image_tag: loading: 'lazy', widths: '80, 120, 160', sizes: '72px', alt: product.title }}{% endif %}</span>
                  <strong>{{ product.title | escape }}</strong>
                  <em>{{ product.price | money }}</em>
                </a>
              {% else %}<a href="{{ routes.all_products_collection_url }}"><strong>Lihat seluruh produk</strong></a>{% endfor %}
            </div>
          </div>
        </article>
      {% endif %}{% endfor %}
    </div>
  </div>
</section>

{% stylesheet %}
.catalog-body{background:#f3f4f5;color:#222;padding:24px 0 42px}.catalog-body__inner{max-width:1320px}.catalog-body__header{background:#fff;padding:18px 20px 10px}.catalog-body__header h2{font-size:20px;font-weight:800;letter-spacing:0;margin:0}.catalog-body__header p{font-size:11px;margin:4px 0;color:#5c6870}.catalog-body__categories{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));background:#fff;padding:10px 20px 22px}.catalog-category{display:grid;grid-template-rows:100px auto auto;place-items:center;min-width:0;padding:12px 8px;border:1px solid #d9dde0;border-right:0;text-align:center;transition:box-shadow .25s,transform .25s}.catalog-category:last-child{border-right:1px solid #d9dde0}.catalog-category:hover{z-index:1;transform:translateY(-2px);box-shadow:0 7px 18px #102d4018}.catalog-category__image{display:grid;place-items:center;width:100%;height:92px}.catalog-category__image img{width:100%;height:88px;object-fit:contain}.catalog-category strong{font-size:12px;line-height:1.2}.catalog-category>span:last-child{font-size:10px;color:#68757d;margin-top:4px}.catalog-brands{background:#fff;padding:0 20px 22px}.catalog-brands__label{display:flex;gap:10px;align-items:center;border-top:1px solid #e4e7e9;padding-top:14px}.catalog-brands__label strong{font-size:14px}.catalog-brands__label a{font-size:10px;color:#1269a0}.catalog-brands__list{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:8px;margin-top:10px}.catalog-brands__list a{display:grid;place-items:center;height:62px;border:1px solid #d9dde0;background:#fff;padding:8px}.catalog-brands__list img{max-width:100%;height:42px;object-fit:contain}.catalog-groups{display:grid;gap:18px;margin-top:18px}.catalog-group{background:#fff;border:1px solid #dfe3e5;border-radius:4px;overflow:hidden}.catalog-group__heading{display:grid;grid-template-columns:58px 1fr auto;align-items:center;gap:10px;padding:10px 14px;border-bottom:1px solid #dfe3e5}.catalog-group__thumb{display:grid;place-items:center;width:54px;height:48px}.catalog-group__thumb img{width:100%;height:46px;object-fit:contain}.catalog-group__heading h3{font-size:15px;font-weight:800;margin:0}.catalog-group__heading span{font-size:10px;color:#65727b}.catalog-group__heading>a{font-size:11px;color:#1269a0;font-weight:700}.catalog-group__content{display:grid;grid-template-columns:180px minmax(0,1fr);gap:0;padding:10px}.catalog-group__feature{display:grid;grid-template-rows:135px auto auto;place-items:center;padding:10px;border-right:1px solid #dfe3e5;text-align:center}.catalog-group__feature-image{display:grid;place-items:center;width:100%;height:130px}.catalog-group__feature-image img{width:100%;height:125px;object-fit:contain}.catalog-group__feature strong{font-size:13px}.catalog-group__feature>span:last-child{font-size:10px;color:#1269a0}.catalog-group__products{display:grid;grid-template-columns:repeat(4,minmax(0,1fr))}.catalog-group__products a{display:grid;grid-template-columns:64px minmax(0,1fr);grid-template-rows:auto auto;column-gap:8px;min-width:0;padding:10px;border-right:1px solid #e6e9eb;border-bottom:1px solid #e6e9eb}.catalog-group__products a:nth-child(4n){border-right:0}.catalog-group__products a:nth-last-child(-n+4){border-bottom:0}.catalog-group__products a>span{grid-row:1/3;display:grid;place-items:center}.catalog-group__products img{width:62px;height:62px;object-fit:contain}.catalog-group__products strong{font-size:11px;font-weight:600;line-height:1.25;max-height:2.5em;overflow:hidden}.catalog-group__products em{font-size:11px;color:#d7271c;font-style:normal;font-weight:700;margin-top:4px}
@media(max-width:989px){.catalog-body__categories{grid-template-columns:repeat(3,minmax(0,1fr))}.catalog-category:nth-child(3){border-right:1px solid #d9dde0}.catalog-group__products{grid-template-columns:repeat(2,minmax(0,1fr))}.catalog-group__products a:nth-child(odd){border-right:1px solid #e6e9eb}.catalog-group__products a:nth-child(even){border-right:0}.catalog-group__products a:nth-last-child(-n+4){border-bottom:1px solid #e6e9eb}.catalog-group__products a:nth-last-child(-n+2){border-bottom:0}}
@media(max-width:749px){.catalog-body{padding:12px 0 28px}.catalog-body__inner{width:100%}.catalog-body__header{padding:14px 12px 8px}.catalog-body__header h2{font-size:17px}.catalog-body__categories{grid-template-columns:repeat(3,minmax(0,1fr));padding:6px 10px 14px}.catalog-category{grid-template-rows:72px auto auto;padding:9px 5px}.catalog-category__image{height:67px}.catalog-category__image img{height:64px}.catalog-category strong{font-size:10px}.catalog-brands{padding:0 10px 14px}.catalog-brands__list{display:flex;overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none}.catalog-brands__list a{flex:0 0 115px;scroll-snap-align:start}.catalog-groups{gap:10px;margin-top:10px}.catalog-group{border-radius:0}.catalog-group__heading{grid-template-columns:48px 1fr auto;padding:8px 10px}.catalog-group__thumb{width:44px;height:42px}.catalog-group__heading h3{font-size:13px}.catalog-group__heading>a{font-size:9px}.catalog-group__content{grid-template-columns:105px minmax(0,1fr);padding:6px}.catalog-group__feature{grid-template-rows:85px auto auto;padding:6px}.catalog-group__feature-image{height:82px}.catalog-group__feature-image img{height:80px}.catalog-group__feature strong{font-size:10px}.catalog-group__products{grid-template-columns:1fr}.catalog-group__products a{grid-template-columns:48px minmax(0,1fr);min-height:65px;padding:6px;border-right:0!important;border-bottom:1px solid #e6e9eb!important}.catalog-group__products a:nth-child(n+5){display:none}.catalog-group__products a:last-child{border-bottom:0!important}.catalog-group__products img{width:46px;height:46px}.catalog-group__products strong,.catalog-group__products em{font-size:9px}}
{% endstylesheet %}

{% schema %}
{"name":"Catalog Body","settings":[{"type":"text","id":"heading","label":"Judul","default":"Kategori unggulan BAITANDSTRIKE"},{"type":"text","id":"text","label":"Keterangan","default":"Temukan produk berdasarkan kebutuhan memancing."},{"type":"text","id":"brand_heading","label":"Judul merek","default":"Brand Populer"}],"max_blocks":12,"blocks":[{"type":"category","name":"Kategori","settings":[{"type":"text","id":"title","label":"Judul"},{"type":"collection","id":"collection","label":"Koleksi"},{"type":"image_picker","id":"image","label":"Gambar"},{"type":"text","id":"asset","label":"Nama aset tema"}]},{"type":"brand","name":"Merek","settings":[{"type":"text","id":"vendor","label":"Nama vendor"},{"type":"image_picker","id":"image","label":"Logo"}]}],"presets":[{"name":"Catalog Body"}]}
{% endschema %}

