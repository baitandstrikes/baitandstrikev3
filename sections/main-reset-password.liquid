<section class="section wrap auth-page"><h1>{{ 'customer.reset' | t }}</h1>{% form 'reset_customer_password' %}{{ form.errors | default_errors }}<label for="ResetPassword">{{ 'general.password' | t }}</label><input id="ResetPassword" name="customer[password]" type="password" autocomplete="new-password" required><label for="ResetConfirm">{{ 'customer.confirm_password' | t }}</label><input id="ResetConfirm" name="customer[password_confirmation]" type="password" autocomplete="new-password" required><button class="button">{{ 'customer.reset' | t }}</button>{% endform %}</section>
{% schema %}
{
  "name": "Main Reset Password",
  "settings": []
}
{% endschema %}
