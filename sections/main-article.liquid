<article class="section wrap narrow"><p class="eyebrow">{{ article.published_at | date: '%d %B %Y' }}</p><h1>{{ article.title | escape }}</h1>{% if article.image %}{{ article.image | image_url: width: 1400 | image_tag: loading: 'eager', widths: '400, 700, 1000, 1400', sizes: '100vw' }}{% endif %}<div class="rte">{{ article.content }}</div>{% if blog.comments_enabled? %}<h2>{{ 'blog.comment' | t }}</h2>{% paginate article.comments by 20 %}{% for comment in article.comments %}<div class="comment"><strong>{{ comment.author | escape }}</strong><div class="rte">{{ comment.content }}</div></div>{% endfor %}{{ paginate | default_pagination }}{% endpaginate %}{% form 'new_comment', article %}{{ form.errors | default_errors }}{% if form.posted_successfully? %}<p>{{ 'blog.comment_success' | t }}</p>{% endif %}<label for="CommentName">{{ 'general.name' | t }}</label><input id="CommentName" name="comment[author]" required><label for="CommentEmail">{{ 'general.email' | t }}</label><input id="CommentEmail" type="email" name="comment[email]" required><label for="CommentBody">{{ 'blog.comment' | t }}</label><textarea id="CommentBody" name="comment[body]" required></textarea><button class="button">{{ 'general.submit' | t }}</button>{% endform %}{% endif %}</article>
{% schema %}
{
  "name": "Main Article",
  "settings": []
}
{% endschema %}
