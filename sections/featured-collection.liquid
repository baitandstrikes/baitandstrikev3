{% assign c = section.settings.collection | default: collections.all %}<section class="section wrap reveal" data-carousel><div class="section-heading"><div><p class="eyebrow">{{ section.settings.eyebrow | escape }}</p><h2>{{ section.settings.title | default: c.title | escape }}</h2></div><div class="heading-actions"><a class="text-link" href="{{ c.url | default: routes.all_products_collection_url }}">{{ 'general.view_all' | t }}</a><button class="icon-button" data-carousel-prev aria-label="{{ 'general.previous' | t }}">{% render 'icon', name: 'arrow' %}</button><button class="icon-button" data-carousel-next aria-label="{{ 'general.next' | t }}">{% render 'icon', name: 'arrow' %}</button></div></div><div class="product-carousel" data-carousel-track>{% for product in c.products limit: section.settings.limit %}{% render 'product-card', product: product %}{% else %}<p>{{ 'general.empty' | t }}</p>{% endfor %}</div></section>
{% schema %}
{
  "name": "Featured Collection",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Koleksi"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Teks kecil",
      "default": "PILIHAN BNS"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Judul",
      "default": "Siap untuk trip berikutnya"
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Jumlah produk",
      "min": 4,
      "max": 16,
      "step": 1,
      "default": 8
    }
  ],
  "presets": [
    {
      "name": "Featured Collection"
    }
  ]
}
{% endschema %}
