<footer class="site-footer"><div class="wrap footer-grid"><div class="footer-about"><a class="brand" href="{{ routes.root_url }}"><img src="{{ 'IMG_05521.png' | file_url }}" width="260" height="65" loading="lazy" alt="{{ shop.name | escape }}"></a><div class="rte">{{ section.settings.text }}</div><p><a class="text-link" href="https://wa.me/6287795361519">{{ 'b2b.help' | t }}</a></p></div>
{% for block in section.blocks %}<div {{ block.shopify_attributes }}><h3>{{ block.settings.title | escape }}</h3>{% if block.id == 'shop' or block.settings.title == 'Jelajahi' %}<div class="social-links footer-social-links">{% if section.settings.instagram != blank %}<a href="{{ section.settings.instagram }}" aria-label="Instagram" target="_blank" rel="noopener noreferrer">{% render 'icon', name: 'instagram' %}</a>{% endif %}{% if section.settings.tiktok != blank %}<a href="{{ section.settings.tiktok }}" aria-label="TikTok" target="_blank" rel="noopener noreferrer">{% render 'icon', name: 'tiktok' %}</a>{% endif %}{% if section.settings.youtube != blank %}<a href="{{ section.settings.youtube }}" aria-label="YouTube" target="_blank" rel="noopener noreferrer">{% render 'icon', name: 'youtube' %}</a>{% endif %}{% if section.settings.facebook != blank %}<a href="{{ section.settings.facebook }}" aria-label="Facebook" target="_blank" rel="noopener noreferrer">{% render 'icon', name: 'facebook' %}</a>{% endif %}</div>{% else %}<ul class="footer-menu">{% for link in block.settings.menu.links %}<li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>{% endfor %}</ul>{% endif %}</div>{% endfor %}
<div class="newsletter"><h3>{{ section.settings.newsletter_title | escape }}</h3><p>{{ section.settings.newsletter_text | escape }}</p>{% assign newsletter_id = 'Newsletter-' | append: section.id %}{% form 'customer', id: newsletter_id %}<input type="hidden" name="contact[tags]" value="newsletter">{% if form.posted_successfully? %}<p role="status">{{ 'general.newsletter_ok' | t }}</p>{% endif %}{{ form.errors | default_errors }}<label class="visually-hidden" for="NewsletterEmail-{{ section.id }}">{{ 'general.email' | t }}</label><div class="newsletter-input"><input type="email" id="NewsletterEmail-{{ section.id }}" name="contact[email]" autocomplete="email" placeholder="{{ 'general.email' | t }}" required><button class="icon-button" aria-label="{{ 'general.subscribe' | t }}">{% render 'icon', name: 'arrow' %}</button></div>{% endform %}</div></div>
<div class="wrap footer-bottom"><p>© {{ 'now' | date: '%Y' }} {{ shop.name | escape }}</p><div class="policy-links">{% for policy in shop.policies %}{% if policy != blank %}<a href="{{ policy.url }}">{{ policy.title | escape }}</a>{% endif %}{% endfor %}</div><div class="payment-icons">{% for type in shop.enabled_payment_types %}{{ type | payment_type_svg_tag: class: 'payment-icon' }}{% endfor %}</div></div></footer>
{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "richtext",
      "id": "text",
      "label": "Tentang BNS",
      "default": "<p>Peralatan mancing dan aksesori untuk trip berikutnya.<br>Jl. Makaliwe Raya No.36, Grogol, Jakarta Barat 11450.</p>"
    },
    {
      "type": "text",
      "id": "newsletter_title",
      "label": "Judul newsletter",
      "default": "Tetap dekat dengan BNS."
    },
    {
      "type": "text",
      "id": "newsletter_text",
      "label": "Deskripsi newsletter",
      "default": "Dapatkan kabar produk dan koleksi terbaru."
    },
    {
      "type": "url",
      "id": "instagram",
      "label": "Instagram"
    },
    {
      "type": "url",
      "id": "tiktok",
      "label": "Tiktok"
    },
    {
      "type": "url",
      "id": "youtube",
      "label": "Youtube"
    },
    {
      "type": "url",
      "id": "facebook",
      "label": "Facebook"
    }
  ],
  "max_blocks": 2,
  "blocks": [
    {
      "type": "menu",
      "name": "Menu",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Judul",
          "default": "Bantuan"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu"
        }
      ]
    }
  ]
}
{% endschema %}
