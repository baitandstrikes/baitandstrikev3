<footer class="site-footer site-footer--pdf">
  <div class="wrap footer-grid footer-grid--pdf">
    <div class="footer-about">
      <a class="brand" href="{{ routes.root_url }}">
        <img src="{{ 'bns-footer-logo.png' | asset_url }}" width="3537" height="448" loading="lazy" alt="BAIT &amp; STRIKE Fishing Gear">
      </a>
      <p class="footer-tagline">{{ section.settings.tagline | escape }}</p>
    </div>

    <div class="footer-showroom">
      <h3>Showroom</h3>
      <p>{{ section.settings.showroom_address | escape }}</p>
      <p><strong>Email</strong><br><a href="mailto:{{ section.settings.email | escape }}">{{ section.settings.email | escape }}</a></p>
    </div>

    <div class="footer-information">
      <h3>Informasi</h3>
      <ul class="footer-menu">
        <li><a href="/pages/contact">Kontak Kami</a></li>
        <li><a href="/pages/tentangkami">Tentang Kami</a></li>
        <li><a href="/policies/privacy-policy">Kebijakan Privasi</a></li>
      </ul>
    </div>

    <div class="footer-categories">
      <h3>Kategori</h3>
      <ul class="footer-menu">
        <li><a href="{{ routes.collections_url }}/fishing-rods-joran">Joran</a></li>
        <li><a href="{{ routes.collections_url }}/reel">Reel</a></li>
        <li><a href="{{ routes.collections_url }}/fishing-bait">Umpan</a></li>
        <li><a href="{{ routes.collections_url }}/fishing-line">Senar</a></li>
        <li><a href="{{ routes.collections_url }}/fishing-accesories">Aksesori</a></li>
        <li><a href="{{ routes.collections_url }}/hook">Hook</a></li>
      </ul>
    </div>
  </div>
</footer>
{% stylesheet %}
.site-footer--pdf{padding:42px 0;background:#f3f4f5;color:#555}
.footer-grid--pdf{display:grid;grid-template-columns:minmax(200px,1.3fr) minmax(260px,1.7fr) minmax(120px,.8fr) minmax(110px,.7fr);gap:34px;max-width:1240px}
body.page-index.catalog-refresh .footer-grid--pdf{width:calc(100% - 48px);max-width:1160px;margin-inline:auto}
.footer-grid--pdf h3{margin:0 0 12px;color:#222;font-size:15px;font-weight:700}
.footer-grid--pdf p,.footer-grid--pdf a{font-size:13px;line-height:1.6}
.footer-grid--pdf p{margin:0 0 14px}
.footer-grid--pdf .brand{display:inline-block}
.footer-grid--pdf .brand img{display:block;width:min(100%,300px);max-height:58px;object-fit:contain;object-position:left center}
.footer-tagline{margin-top:12px!important;color:#69747d}
.footer-showroom strong{color:#333}
.footer-grid--pdf .footer-menu{display:grid;gap:6px;margin:0;padding:0;list-style:none}
.footer-grid--pdf .footer-menu a{color:#60666b}
.footer-grid--pdf .footer-menu a:hover,.footer-showroom a:hover{color:#1269a0}
@media(max-width:900px){.footer-grid--pdf{grid-template-columns:repeat(2,minmax(0,1fr));gap:28px}}
@media(max-width:550px){.site-footer--pdf{padding:30px 0}.footer-grid--pdf{grid-template-columns:1fr;gap:24px}.footer-grid--pdf .brand img{max-width:260px}}
{% endstylesheet %}
{% schema %}
{
  "name": "Footer",
  "settings": [
    {"type":"text","id":"tagline","label":"Teks brand","default":"#TumbuhBersamaBNSStore"},
    {"type":"textarea","id":"showroom_address","label":"Alamat showroom","default":"Jl. Makaliwe Raya No.36, RT.2/RW.5, Grogol, Kec. Grogol Petamburan, Kota Jakarta Barat, Daerah Khusus Ibukota Jakarta 11450"},
    {"type":"text","id":"email","label":"Email","default":"baitandstrike@gmail.com"}
  ]
}
{% endschema %}
