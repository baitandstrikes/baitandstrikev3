<section class="collection-header wrap"><nav class="breadcrumbs"><a href="{{ routes.root_url }}">{{ 'general.home' | t }}</a><span>/</span><span>{{ collection.title | escape }}</span></nav><h1>{{ collection.title | escape }}</h1>{% if collection.description != blank %}<div class="rte">{{ collection.description }}</div>{% endif %}</section><section class="section wrap catalog"><div class="catalog-bar"><p>{{ 'general.results' | t: count: collection.products_count }}</p><form method="get" class="sort-form">{% for filter in collection.filters %}{% for value in filter.active_values %}<input type="hidden" name="{{ value.param_name }}" value="{{ value.value | escape }}">{% endfor %}{% if filter.type == 'price_range' %}{% if filter.min_value.value %}<input type="hidden" name="{{ filter.min_value.param_name }}" value="{{ filter.min_value.value | divided_by: 100.0 }}">{% endif %}{% if filter.max_value.value %}<input type="hidden" name="{{ filter.max_value.param_name }}" value="{{ filter.max_value.value | divided_by: 100.0 }}">{% endif %}{% endif %}{% endfor %}<label for="SortBy">{{ 'general.sort' | t }}</label><select name="sort_by" id="SortBy">{% assign sort = collection.sort_by | default: collection.default_sort_by %}{% for option in collection.sort_options %}<option value="{{ option.value }}"{% if option.value == sort %} selected{% endif %}>{{ option.name | escape }}</option>{% endfor %}</select><button class="button button-small">{{ 'general.apply' | t }}</button></form></div><div class="catalog-layout">{% if section.settings.filters %}<aside class="catalog-filters"><form class="filter-form" method="get"><input type="hidden" name="sort_by" value="{{ collection.sort_by | default: collection.default_sort_by }}"><h2>{{ 'general.filter' | t }}</h2>{% for filter in collection.filters %}<details class="filter-group" open><summary>{{ filter.label | escape }}{% render 'icon', name: 'chevron' %}</summary><div class="filter-values">{% case filter.type %}{% when 'boolean', 'list' %}{% for value in filter.values %}<label class="checkbox"><input type="checkbox" name="{{ value.param_name }}" value="{{ value.value | escape }}"{% if value.active %} checked{% endif %}{% if value.count == 0 and value.active == false %} disabled{% endif %}><span>{{ value.label | escape }}</span><small>{{ value.count }}</small></label>{% endfor %}{% when 'price_range' %}<div class="price-range"><label>{{ 'general.min_price' | t }}<input name="{{ filter.min_value.param_name }}" type="number" min="0" max="{{ filter.range_max | divided_by: 100.0 }}"{% if filter.min_value.value %} value="{{ filter.min_value.value | divided_by: 100.0 }}"{% endif %} placeholder="0"></label><label>{{ 'general.max_price' | t }}<input name="{{ filter.max_value.param_name }}" type="number" min="0" max="{{ filter.range_max | divided_by: 100.0 }}"{% if filter.max_value.value %} value="{{ filter.max_value.value | divided_by: 100.0 }}"{% endif %} placeholder="{{ filter.range_max | divided_by: 100.0 }}"></label></div>{% endcase %}</div></details>{% endfor %}<button class="button button-small">{{ 'general.apply' | t }}</button><a class="text-link" href="{{ collection.url }}">{{ 'general.reset' | t }}</a></form></aside>{% endif %}<div class="catalog-products">{% paginate collection.products by section.settings.per_page %}<div class="product-grid">{% for product in collection.products %}{% render 'product-card', product: product %}{% else %}<p>{{ 'general.empty' | t }}</p>{% endfor %}</div><div class="pagination">{{ paginate | default_pagination }}</div>{% endpaginate %}</div></div></section>
{% schema %}
{
  "name": "Main Collection",
  "settings": [
    {
      "type": "checkbox",
      "id": "filters",
      "label": "Tampilkan filter Shopify",
      "default": true
    },
    {
      "type": "range",
      "id": "per_page",
      "label": "Produk per halaman",
      "min": 12,
      "max": 48,
      "step": 4,
      "default": 24
    }
  ]
}
{% endschema %}
