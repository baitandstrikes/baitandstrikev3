<section class="section wrap brand-discovery"><div class="section-heading"><div><h2>{{ section.settings.title | escape }}</h2><p>{{ section.settings.text | escape }}</p></div></div><div class="brand-grid">{% if section.blocks.size > 0 %}{% for block in section.blocks %}{% if block.settings.vendor != blank %}<div {{ block.shopify_attributes }}>{% if block.settings.image %}<a class="brand-link" href="{{ routes.root_url }}collections/vendors?q={{ block.settings.vendor | url_encode }}">{{ block.settings.image | image_url: width: 360 | image_tag: loading: 'lazy', alt: block.settings.vendor }}<span>{{ block.settings.vendor | escape }}</span></a>{% else %}{{ block.settings.vendor | link_to_vendor: class: 'brand-link' }}{% endif %}</div>{% endif %}{% endfor %}{% else %}{% for vendor in shop.vendors limit: 12 %}{{ vendor | link_to_vendor: class: 'brand-link' }}{% endfor %}{% endif %}</div></section>
{% schema %}{"name":"Pilihan Merek","settings":[{"type":"text","id":"title","label":"Judul","default":"Belanja berdasarkan merek"},{"type":"text","id":"text","label":"Keterangan","default":"Temukan perlengkapan dari merek pilihanmu."}],"max_blocks":16,"blocks":[{"type":"brand","name":"Merek","settings":[{"type":"text","id":"vendor","label":"Nama merek sesuai vendor produk"},{"type":"image_picker","id":"image","label":"Logo merek (opsional)"}]}],"presets":[{"name":"Pilihan Merek"}]}{% endschema %}
