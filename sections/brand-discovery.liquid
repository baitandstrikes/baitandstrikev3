{% if section.blocks.size > 0 %}<section id="shop-by-brand" class="section wrap brand-discovery"><div class="section-heading"><div><h2>{{ section.settings.title | escape }}</h2><p>{{ section.settings.text | escape }}</p></div></div><div class="brand-grid">{% for block in section.blocks %}{% if block.settings.vendor != blank %}<div {{ block.shopify_attributes }}><a class="brand-link" href="{{ routes.root_url }}collections/vendors?q={{ block.settings.vendor | url_encode }}">{% if block.settings.image %}<span class="brand-logo-frame{% if block.settings.fit == 'cover' %} brand-logo-frame--crop{% endif %}">{{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy', widths: '180, 360, 600', sizes: '(min-width: 990px) 18vw, 42vw', alt: '' }}</span>{% endif %}<span>{{ block.settings.vendor | escape }}</span></a></div>{% endif %}{% endfor %}</div></section>{% endif %}
{% stylesheet %}
.brand-discovery .brand-grid{grid-template-columns:repeat(5,minmax(0,1fr))}.brand-discovery .brand-link{height:100%;background:#fff}.brand-discovery .brand-logo-frame{display:block;overflow:hidden;width:100%;height:64px}.brand-discovery .brand-logo-frame img{height:100%;width:100%;object-fit:contain;max-height:none}.brand-discovery .brand-logo-frame--crop img{object-fit:cover;object-position:center}
@media(max-width:989px) and (min-width:750px){.brand-discovery .brand-grid{grid-template-columns:repeat(3,minmax(0,1fr))}}
@media(max-width:749px){.brand-discovery .brand-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.brand-discovery .brand-grid>div:last-child:nth-child(odd){grid-column:1/-1;width:calc(50% - 6px);justify-self:center}}
{% endstylesheet %}
{% schema %}{"name":"Pilihan Merek","settings":[{"type":"text","id":"title","label":"Judul","default":"Belanja berdasarkan merek"},{"type":"text","id":"text","label":"Keterangan","default":"Temukan perlengkapan dari merek pilihanmu."}],"max_blocks":16,"blocks":[{"type":"brand","name":"Merek","settings":[{"type":"text","id":"vendor","label":"Nama merek sesuai vendor produk"},{"type":"image_picker","id":"image","label":"Logo merek"},{"type":"select","id":"fit","label":"Tampilan logo","options":[{"value":"contain","label":"Tampilkan seluruh gambar"},{"value":"cover","label":"Rapikan ruang kosong di tepi"}],"default":"contain"}]}],"presets":[{"name":"Pilihan Merek"}]}{% endschema %}
