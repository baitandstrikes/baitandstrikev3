<section class="section wrap account-access" aria-labelledby="AccountLoginHeading">
  <div class="account-access__card">
    <p class="eyebrow">{{ 'customer_access.login_eyebrow' | t }}</p>
    <h1 id="AccountLoginHeading">{{ 'customer_access.login_title' | t }}</h1>
    <p class="account-access__copy">{{ 'customer_access.login_intro' | t }}</p>
    <div class="account-access__actions">
      <a class="button" href="{{ routes.account_login_url }}">{{ 'customer_access.login_button' | t }}</a>
      <a class="button button-white" href="{{ pages['wholesale-registration-form'].url | default: '/pages/wholesale-registration-form' }}">{{ 'wholesale_registration.wholesale_link' | t }}</a>
    </div>
    <p class="account-access__note">{{ 'customer_access.login_note' | t }}</p>
  </div>
</section>
{% schema %}
{
  "name": "Main Login",
  "settings": []
}
{% endschema %}
