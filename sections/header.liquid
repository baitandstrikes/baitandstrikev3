<header class="site-header{% if section.settings.transparent and request.page_type == 'index' %} is-transparent{% endif %}{% if section.settings.sticky %} is-sticky{% endif %}" data-header>
<div class="header-main wrap"><div class="header-left"><button class="icon-button search-launch" data-search-toggle aria-expanded="false" aria-controls="HeaderSearch" aria-label="{{ 'general.search' | t }}">{% render 'icon', name: 'search' %}<span>{{ 'discovery.search_hint' | t }}</span></button></div>
<a href="{{ routes.root_url }}" class="brand" style="--logo-width:{{ section.settings.logo_width }}px">{% if section.settings.logo != blank %}{{ section.settings.logo | image_url: width: 600 | image_tag: widths: '200, 300, 400, 600', loading: 'eager', alt: shop.name }}{% elsif section.settings.logo_url != blank %}<img src="{{ section.settings.logo_url | escape }}" width="260" height="65" alt="{{ shop.name | escape }}">{% else %}BAIT<span>AND</span>STRIKE{% endif %}</a>
<div class="header-right"><button type="button" class="icon-button header-action" data-tools-open="wishlist" aria-haspopup="dialog" aria-controls="ShoppingTools" aria-label="{{ 'tools.wishlist' | t }}"><span class="header-action__icon">{% render 'icon', name: 'heart' %}</span><span class="header-action__label">{{ 'tools.wishlist' | t }}</span></button>{% if shop.customer_accounts_enabled %}<button type="button" class="icon-button header-action" data-open-account aria-haspopup="dialog" aria-controls="AccountDialog" aria-label="{{ 'general.account' | t }}"><span class="header-action__icon">{% render 'icon', name: 'account' %}</span><span class="header-action__label">{{ 'general.account' | t }}</span></button>{% endif %}<a href="{{ routes.cart_url }}" class="icon-button header-action cart-trigger" data-open-cart aria-label="{{ 'general.cart' | t }}"><span class="header-action__icon">{% render 'icon', name: 'bag' %}<span class="cart-count" data-cart-count>{{ cart.item_count }}</span></span><span class="header-action__label">{{ 'general.cart' | t }}</span></a></div></div>
<div class="mobile-search-row wrap"><button class="icon-button mobile-menu" data-menu-toggle aria-expanded="false" aria-controls="MainNav" aria-label="{{ 'general.menu' | t }}">{% render 'icon', name: 'menu' %}</button><button type="button" class="search-mobile-launch" data-search-toggle aria-expanded="false" aria-controls="HeaderSearch">{% render 'icon', name: 'search' %}<span>{{ 'discovery.search_hint' | t }}</span></button></div>
<nav id="MainNav" class="main-nav" aria-label="{{ 'general.menu' | t }}"><div class="menu-dismiss"><span>{{ 'general.menu' | t }}</span><button class="icon-button" data-menu-toggle aria-label="{{ 'general.close' | t }}">{% render 'icon', name: 'close' %}</button></div><div class="nav-inner wrap">{% if section.settings.menu != blank %}{% for link in section.settings.menu.links %}{% if link.links != blank %}{% assign menu_title = link.title | downcase %}<details class="mega-item{% if menu_title contains 'product' or menu_title contains 'catalog' or menu_title contains 'produk' or menu_title contains 'categor' or menu_title contains 'kategori' %} product-mega-item{% endif %}"><summary>{% if menu_title contains 'product' or menu_title contains 'catalog' or menu_title contains 'produk' or menu_title contains 'categor' or menu_title contains 'kategori' %}Product{% else %}{{ link.title | escape }}{% endif %}{% render 'icon', name: 'chevron' %}</summary>{% if menu_title contains 'product' or menu_title contains 'catalog' or menu_title contains 'produk' or menu_title contains 'categor' or menu_title contains 'kategori' %}{% render 'product-mega-menu', menu_link: link %}{% else %}<div class="mega-panel"><a class="mega-all" href="{{ link.url }}">{{ 'general.view_all' | t }} {{ link.title | escape }} →</a><div class="mega-columns">{% for child in link.links %}<div><a href="{{ child.url }}" class="mega-heading">{{ child.title | escape }}</a>{% if child.links != blank %}<ul>{% for grand in child.links %}<li><a href="{{ grand.url }}">{{ grand.title | escape }}</a></li>{% endfor %}</ul>{% endif %}</div>{% endfor %}</div></div>{% endif %}</details>{% else %}<a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title | escape }}</a>{% endif %}{% endfor %}{% else %}<a href="{{ routes.all_products_collection_url }}">{{ 'general.collections' | t }}</a><a href="{{ routes.search_url }}">{{ 'general.search' | t }}</a>{% endif %}</div></nav><button type="button" class="menu-backdrop" data-menu-toggle tabindex="-1" aria-label="{{ 'general.close' | t }}"></button>
<div id="HeaderSearch" class="header-search" hidden><form action="{{ routes.search_url }}" method="get" class="wrap search-form" role="search"><label class="visually-hidden" for="HeaderQuery">{{ 'general.search' | t }}</label><input id="HeaderQuery" type="search" name="q" autocomplete="off" data-predictive-input aria-controls="PredictiveResults" placeholder="{{ 'discovery.search_hint' | t }}" required><input type="hidden" name="options[prefix]" value="last"><button class="icon-button" aria-label="{{ 'general.search' | t }}">{% render 'icon', name: 'search' %}</button><button type="button" class="icon-button" data-search-toggle aria-label="{{ 'general.close' | t }}">{% render 'icon', name: 'close' %}</button></form><div id="PredictiveResults" class="predictive-results wrap" aria-live="polite" hidden></div></div>
</header>
<style>
.site-header .header-right .header-action{width:auto;height:auto;min-width:48px;min-height:44px;padding:3px 2px;display:flex;flex-direction:column;gap:3px;white-space:nowrap}
.site-header .header-action__icon{position:relative;display:block;line-height:0}
.site-header .header-action__icon>.icon{width:22px;height:22px}
.site-header .header-action__label{font-size:9px;line-height:1.15;letter-spacing:0}
.site-header .header-action .cart-count{top:-5px;right:-8px}
.site-header .mobile-search-row{display:none}
@media(max-width:749px){.site-header .header-main{height:68px;grid-template-columns:minmax(0,1fr) auto}.site-header .header-left{display:none}.site-header .brand{grid-column:1;grid-row:1;justify-self:start;margin-left:0}.site-header .header-right{grid-column:2;grid-row:1;gap:2px}.site-header .header-right .header-action{min-width:40px;padding:2px 0}.site-header .header-action__icon>.icon{width:20px;height:20px}.site-header .header-action__label{font-size:8px}.site-header .mobile-search-row{display:flex;align-items:center;gap:8px;padding-bottom:10px}.site-header .mobile-menu{display:inline-flex;flex:0 0 40px;width:40px;height:44px;color:inherit}.site-header .mobile-search-row .search-mobile-launch{display:flex;flex:1;align-items:center;gap:10px;min-width:0;height:44px;margin:0;padding:0 12px;border:0;border-radius:3px;background:#fff;color:#14212b;text-align:left;font-size:12px}.site-header .search-mobile-launch .icon{width:18px;height:18px}}
</style>
{% if shop.customer_accounts_enabled %}
<dialog id="AccountDialog" class="account-dialog" aria-labelledby="AccountDialogTitle">
<button type="button" class="dialog-close icon-button" data-close-dialog aria-label="{{ 'general.close' | t }}">{% render 'icon', name: 'close' %}</button>
<h2 id="AccountDialogTitle">{{ 'general.account' | t }}</h2>
{% if customer %}<p>{{ customer.first_name | escape }}</p><a class="button" href="{{ routes.account_url }}">Akun &amp; pesanan</a><a class="text-link" href="{{ routes.account_logout_url }}">Logout</a>
{% else %}<p>Masuk ke akun kamu atau daftar sebagai partner BNS.</p><a class="button" href="{{ pages['b2b-login'].url | default: routes.account_login_url }}">Login</a><a class="button button-white" href="{{ pages['wholesale-registration-form'].url | default: routes.account_register_url }}">Daftar B2B</a>{% endif %}
</dialog>
{% endif %}
{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "Lebar logo",
      "min": 160,
      "max": 360,
      "step": 10,
      "unit": "px",
      "default": 260
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu utama",
      "default": "main-menu"
    },
    {
      "type": "checkbox",
      "id": "transparent",
      "label": "Header transparan di homepage",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "sticky",
      "label": "Header sticky",
      "default": true
    },
    {
      "type": "url",
      "id": "logo_url",
      "label": "Logo dari toko referensi"
    }
  ]
}
{% endschema %}
