<header class="site-header{% if section.settings.transparent and request.page_type == 'index' %} is-transparent{% endif %}{% if section.settings.sticky %} is-sticky{% endif %}" data-header>
<div class="header-main wrap"><button class="icon-button mobile-menu" data-menu-toggle aria-expanded="false" aria-controls="MainNav" aria-label="{{ 'general.menu' | t }}">{% render 'icon', name: 'menu' %}</button><div class="header-left"><button class="icon-button search-launch" data-search-toggle aria-expanded="false" aria-controls="HeaderSearch" aria-label="{{ 'general.search' | t }}">{% render 'icon', name: 'search' %}<span>{{ 'discovery.search_hint' | t }}</span></button></div>
<a href="{{ routes.root_url }}" class="brand" style="--logo-width:{{ section.settings.logo_width }}px">{% if section.settings.logo != blank %}{{ section.settings.logo | image_url: width: 600 | image_tag: widths: '200, 300, 400, 600', loading: 'eager', alt: shop.name }}{% elsif section.settings.logo_url != blank %}<img src="{{ section.settings.logo_url | escape }}" width="260" height="65" alt="{{ shop.name | escape }}">{% else %}BAIT<span>AND</span>STRIKE{% endif %}</a>
<div class="header-right"><button type="button" class="icon-button header-action" data-tools-open="wishlist" aria-haspopup="dialog" aria-controls="ShoppingTools" aria-label="{{ 'tools.wishlist' | t }}"><span class="header-action__icon">{% render 'icon', name: 'heart' %}</span><span class="header-action__label">{{ 'tools.wishlist' | t }}</span></button>{% if shop.customer_accounts_enabled %}<button type="button" class="icon-button header-action" data-open-account aria-haspopup="dialog" aria-controls="AccountDialog" aria-label="{{ 'general.account' | t }}"><span class="header-action__icon">{% render 'icon', name: 'account' %}</span><span class="header-action__label">{{ 'general.account' | t }}</span></button>{% endif %}<a href="{{ routes.cart_url }}" class="icon-button header-action cart-trigger" data-open-cart aria-label="{{ 'general.cart' | t }}"><span class="header-action__icon">{% render 'icon', name: 'bag' %}<span class="cart-count" data-cart-count>{{ cart.item_count }}</span></span><span class="header-action__label">{{ 'general.cart' | t }}</span></a></div></div>
<form action="{{ routes.search_url }}" method="get" class="catalog-header-search wrap" role="search"><label class="visually-hidden" for="DesktopHeaderQuery">{{ 'general.search' | t }}</label><input id="DesktopHeaderQuery" type="search" name="q" autocomplete="off" data-predictive-input data-predictive-results="DesktopPredictiveResults" aria-controls="DesktopPredictiveResults" placeholder="{{ 'discovery.search_hint' | t }}" required><input type="hidden" name="options[prefix]" value="last"><button type="submit" class="catalog-header-search__submit" aria-label="{{ 'general.search' | t }}">{% render 'icon', name: 'search' %}</button><div id="DesktopPredictiveResults" class="predictive-results desktop-predictive-results wrap" aria-live="polite" hidden></div></form>
<div class="mobile-search-row wrap"><button type="button" class="mobile-search-back" aria-label="Kembali" onclick="history.back()"><svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M19 12H5m7 7-7-7 7-7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></button><form action="{{ routes.search_url }}" method="get" class="mobile-search-form" role="search"><label class="visually-hidden" for="MobileHeaderQuery">{{ 'general.search' | t }}</label><input id="MobileHeaderQuery" type="search" name="q" autocomplete="off" data-predictive-input data-predictive-results="MobilePredictiveResults" aria-controls="MobilePredictiveResults" placeholder="{{ 'discovery.search_hint' | t }}" required><input type="hidden" name="options[prefix]" value="last"><button type="submit" class="mobile-search-submit" aria-label="{{ 'general.search' | t }}">{% render 'icon', name: 'search' %}</button></form><div id="MobilePredictiveResults" class="predictive-results mobile-predictive-results wrap" aria-live="polite" hidden></div></div>
<nav id="MainNav" class="main-nav" aria-label="{{ 'general.menu' | t }}"><div class="menu-dismiss"><span>{{ 'general.menu' | t }}</span><button class="icon-button" data-menu-toggle aria-label="{{ 'general.close' | t }}">{% render 'icon', name: 'close' %}</button></div><div class="nav-inner wrap">{% if section.settings.menu != blank %}{% for link in section.settings.menu.links %}{% if link.links != blank %}{% assign menu_title = link.title | downcase %}<details class="mega-item{% if menu_title contains 'product' or menu_title contains 'catalog' or menu_title contains 'produk' or menu_title contains 'categor' or menu_title contains 'kategori' %} product-mega-item{% endif %}"><summary>{% if menu_title contains 'product' or menu_title contains 'catalog' or menu_title contains 'produk' or menu_title contains 'categor' or menu_title contains 'kategori' %}Product{% else %}{{ link.title | escape }}{% endif %}{% render 'icon', name: 'chevron' %}</summary>{% if menu_title contains 'product' or menu_title contains 'catalog' or menu_title contains 'produk' or menu_title contains 'categor' or menu_title contains 'kategori' %}{% render 'product-mega-menu', menu_link: link %}{% else %}<div class="mega-panel"><a class="mega-all" href="{{ link.url }}">{{ 'general.view_all' | t }} {{ link.title | escape }} →</a><div class="mega-columns">{% for child in link.links %}<div><a href="{{ child.url }}" class="mega-heading">{{ child.title | escape }}</a>{% if child.links != blank %}<ul>{% for grand in child.links %}<li><a href="{{ grand.url }}">{{ grand.title | escape }}</a></li>{% endfor %}</ul>{% endif %}</div>{% endfor %}</div></div>{% endif %}</details>{% else %}<a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title | escape }}</a>{% endif %}{% endfor %}{% else %}<a href="{{ routes.all_products_collection_url }}">{{ 'general.collections' | t }}</a><a href="{{ routes.search_url }}">{{ 'general.search' | t }}</a>{% endif %}{% assign track_url = section.settings.track_link_url | default: pages['lacak-paket'].url %}{% assign track_in_menu = false %}{% for menu_link in section.settings.menu.links %}{% if track_url != blank and menu_link.url == track_url %}{% assign track_in_menu = true %}{% endif %}{% endfor %}{% if section.settings.show_track_link and track_url != blank and track_in_menu == false %}<a href="{{ track_url }}"{% if page.url == track_url %} aria-current="page"{% endif %}>{{ section.settings.track_link_label | escape }}</a>{% endif %}</div></nav><button type="button" class="menu-backdrop" data-menu-toggle tabindex="-1" aria-label="{{ 'general.close' | t }}"></button>
<div id="HeaderSearch" class="header-search" hidden><form action="{{ routes.search_url }}" method="get" class="wrap search-form" role="search"><label class="visually-hidden" for="HeaderQuery">{{ 'general.search' | t }}</label><input id="HeaderQuery" type="search" name="q" autocomplete="off" data-predictive-input aria-controls="PredictiveResults" placeholder="{{ 'discovery.search_hint' | t }}" required><input type="hidden" name="options[prefix]" value="last"><button class="icon-button" aria-label="{{ 'general.search' | t }}">{% render 'icon', name: 'search' %}</button><button type="button" class="icon-button" data-search-toggle aria-label="{{ 'general.close' | t }}">{% render 'icon', name: 'close' %}</button></form><div id="PredictiveResults" class="predictive-results wrap" aria-live="polite" hidden></div></div>
</header>
<style>
.site-header .header-right .header-action{width:auto;height:auto;min-width:48px;min-height:44px;padding:3px 2px;display:flex;flex-direction:column;gap:3px;white-space:nowrap}
.site-header .header-action__icon{position:relative;display:block;line-height:0}
.site-header .header-action__icon>.icon{width:22px;height:22px}
.site-header .header-action__label{font-size:9px;line-height:1.15;letter-spacing:0}
.site-header .header-action .cart-count{top:-5px;right:-8px}
.site-header .mobile-search-row{display:none}
@media(min-width:750px){body.catalog-refresh .site-header .header-main{width:calc(100% - 48px);max-width:1160px;height:82px;margin-inline:auto}body.catalog-refresh .site-header .brand{justify-self:start}body.catalog-refresh .site-header .brand img{width:115px!important;max-width:115px;max-height:58px;object-fit:contain}body.catalog-refresh .site-header .main-nav,body.catalog-refresh .site-header .nav-inner{height:40px}body.catalog-refresh .site-header .nav-inner{width:calc(100% - 48px);max-width:1160px;margin-inline:auto}}
@media(max-width:749px){.site-header .header-main{height:68px;grid-template-columns:minmax(0,1fr) auto}.site-header .header-left{display:none}.site-header .brand{grid-column:1;grid-row:1;justify-self:start;margin-left:0}.site-header .brand img{transform:translateX(-18px)}.site-header .header-right{grid-column:2;grid-row:1;gap:2px}.site-header .header-right .header-action{min-width:40px;padding:2px 0}.site-header .header-action__icon>.icon{width:20px;height:20px}.site-header .header-action__label{font-size:8px}.site-header .mobile-search-row{display:flex;align-items:center;gap:8px;padding-bottom:10px}.site-header .mobile-menu{display:inline-flex;flex:0 0 40px;width:40px;height:44px;color:inherit}.site-header .mobile-search-row .search-mobile-launch{display:flex;flex:1;align-items:center;gap:10px;min-width:0;height:44px;margin:0;padding:0 12px;border:0;border-radius:3px;background:#fff;color:#14212b;text-align:left;font-size:12px}.site-header .mobile-search-row{display:block;position:static;width:100%;max-width:none;margin:0;padding:0 14px 12px}.site-header .mobile-menu{position:absolute;top:8px;left:12px;z-index:35;width:40px;height:44px;color:inherit}.site-header .brand{margin-left:0!important}.site-header .brand img{transform:translateX(0)}.site-header .mobile-search-form{position:relative;display:flex;align-items:center;width:100%;height:52px;margin:0;border:2px solid #d8e1eb;border-radius:999px;background:#fff;color:#14212b;transition:border-color .15s,box-shadow .15s}.site-header .mobile-search-form:focus-within{border-color:#1684ff;box-shadow:0 0 0 1px #1684ff}.site-header .mobile-search-form input[type=search]{width:100%;height:100%;min-height:0;margin:0;padding:0 50px 0 18px;border:0;border-radius:999px;background:transparent;color:#14212b;font-size:16px;outline:0;box-shadow:none}.site-header .mobile-search-form input[type=search]::-webkit-search-cancel-button{-webkit-appearance:none}.site-header .mobile-search-submit{position:absolute;right:4px;top:50%;display:grid;width:40px;height:40px;place-items:center;transform:translateY(-50%);padding:8px;border:0;border-radius:50%;background:transparent;color:#747d84}.site-header .mobile-search-submit .icon{width:22px;height:22px}}
@media(max-width:749px){.site-header .mobile-search-row{display:flex!important;position:relative;align-items:center;gap:8px;padding:0 14px 12px}.site-header .mobile-menu{position:static!important;top:auto;left:auto;z-index:auto;flex:0 0 40px;width:40px;height:52px}.site-header .mobile-search-form{flex:1;min-width:0}.mobile-predictive-results{position:absolute;z-index:60;top:calc(100% - 8px);left:14px;width:calc(100% - 28px);max-width:none;max-height:55vh;overflow:auto;padding:12px;background:#fff;border:1px solid #d8e1eb;border-radius:12px;box-shadow:0 8px 24px #09274726}.mobile-predictive-results .predictive-grid{grid-template-columns:1fr;gap:0}.mobile-predictive-results .predictive-link{gap:12px;padding:9px 4px;border-bottom:1px solid #edf0f3}.mobile-predictive-results .predictive-link img{width:48px;height:58px;object-fit:contain}.mobile-predictive-results .predictive-link span{font-size:13px}}
@media(max-width:749px){.site-header .mobile-search-row{gap:14px;padding-inline:20px}.site-header .mobile-menu{flex:0 0 44px;width:44px;height:64px}.site-header .mobile-search-form{height:64px}.site-header .mobile-search-form input[type=search]{padding-left:20px;font-size:18px}.site-header .mobile-search-submit{width:44px;height:44px}.site-header .mobile-search-submit .icon{width:24px;height:24px}}
@media(min-width:750px){body.catalog-refresh .site-header .catalog-header-search{height:52px;max-width:560px!important;width:min(560px,calc(100% - 520px))!important;border:2px solid #d8e1eb;border-radius:999px;background:#fff;color:#14212b;box-shadow:none;overflow:visible}body.catalog-refresh .site-header .catalog-header-search input[type=search]{flex:1;min-width:0;height:100%;margin:0;padding:0 0 0 20px;border:0;border-radius:999px;background:transparent;color:#14212b;font-size:16px;outline:0;box-shadow:none}body.catalog-refresh .site-header .catalog-header-search input[type=search]::placeholder{color:#78838c;opacity:1}body.catalog-refresh .site-header .catalog-header-search__submit{width:48px;flex:0 0 48px;padding:0;border:0;background:transparent;color:#747d84}body.catalog-refresh .site-header .catalog-header-search__submit .icon{width:22px;height:22px}body.catalog-refresh .site-header .catalog-header-search:focus-within{border-color:#1684ff;box-shadow:0 0 0 1px #1684ff}.desktop-predictive-results{position:absolute;z-index:60;top:calc(100% + 8px);left:0;width:100%;max-width:none;margin:0;padding:12px;background:#fff;border:1px solid #d8e1eb;border-radius:14px;box-shadow:0 8px 24px #09274726}}

@media(max-width:749px){
.site-header{background:#062b54!important;color:#fff!important}
.site-header .header-main.wrap{display:grid;grid-template-columns:44px minmax(0,1fr) auto;align-items:center;gap:8px;width:100%;max-width:none;height:72px;margin:0;padding:0 16px}
.site-header .header-main .mobile-menu{display:inline-flex!important;position:static!important;grid-column:1;grid-row:1;width:44px;height:44px;flex:0 0 44px;padding:10px;color:#fff}
.site-header .header-main .brand{grid-column:2;grid-row:1;justify-self:end;min-width:0;margin:0 8px 0 0!important;text-align:right;transform:none}
.site-header .header-main .brand img{width:128px!important;max-width:128px;max-height:52px;object-fit:contain;transform:none!important}
.site-header .header-right{grid-column:3;grid-row:1;display:flex;flex-direction:row-reverse;align-items:center;gap:6px}.site-header .header-right{gap:3px}.site-header .header-right .header-action{min-width:36px;width:36px}
.site-header .header-right [data-open-account]{display:flex!important}
.site-header .header-right .header-action{display:flex;width:40px;min-width:40px;height:44px;min-height:44px;padding:8px;color:#fff}
.site-header .header-action__icon>.icon{width:25px;height:25px}
.site-header .header-action__label{display:none}
.site-header .header-action .cart-count{top:1px;right:0;min-width:15px;height:15px;background:#fff;color:#123f5f;font-size:9px}
.site-header .mobile-search-row.wrap{display:flex!important;position:relative;align-items:center;gap:10px;width:100%;max-width:none;margin:0;padding:0 16px 12px}
.site-header .mobile-search-back{display:grid;flex:0 0 32px;width:32px;height:46px;place-items:center;padding:4px;border:0;background:transparent;color:#fff}
.site-header .mobile-search-back .icon{width:24px;height:24px}
.site-header .mobile-search-form{flex:1;min-width:0;height:46px;border:2px solid #d8e1eb;border-radius:999px;background:#fff;color:#14212b}
.site-header .mobile-search-form input[type=search]{padding-left:18px;font-size:16px}
.site-header .mobile-search-submit{width:42px;height:42px;color:#747d84}
.site-header .mobile-search-submit .icon{width:22px;height:22px}
.site-header .mobile-predictive-results{top:calc(100% - 8px);left:62px;width:calc(100% - 78px)}
}
</style>
{% if shop.customer_accounts_enabled %}
<dialog id="AccountDialog" class="account-dialog" aria-labelledby="AccountDialogTitle">
<button type="button" class="dialog-close icon-button" data-close-dialog aria-label="{{ 'general.close' | t }}">{% render 'icon', name: 'close' %}</button>
<h2 id="AccountDialogTitle">{{ 'general.account' | t }}</h2>
{% if customer %}<p>{{ customer.first_name | escape }}</p><a class="button" href="{{ routes.account_url }}">Akun &amp; pesanan</a><a class="text-link" href="{{ routes.account_logout_url }}">Logout</a>
{% else %}<p>Masuk ke akun kamu atau daftar sebagai partner BNS.</p><a class="button" href="{{ pages['b2b-login'].url | default: routes.account_login_url }}">Login</a><a class="button button-white" href="{{ pages['wholesale-registration-form'].url | default: routes.account_register_url }}">Daftar B2B</a>{% endif %}
</dialog>
{% endif %}
{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "Lebar logo",
      "min": 160,
      "max": 360,
      "step": 10,
      "unit": "px",
      "default": 260
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu utama",
      "default": "main-menu"
    },
    {
      "type": "checkbox",
      "id": "transparent",
      "label": "Header transparan di homepage",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "sticky",
      "label": "Header sticky",
      "default": true
    },
    {
      "type": "url",
      "id": "logo_url",
      "label": "Logo dari toko referensi"
    },
    {
      "type": "checkbox",
      "id": "show_track_link",
      "label": "Tampilkan link Lacak Pesanan di menu",
      "info": "Link otomatis hilang kalau sudah dimasukkan ke menu utama di Admin > Navigation.",
      "default": true
    },
    {
      "type": "text",
      "id": "track_link_label",
      "label": "Teks link Lacak Pesanan",
      "default": "Lacak Pesanan"
    },
    {
      "type": "url",
      "id": "track_link_url",
      "label": "Halaman tracking",
      "info": "Kosongkan untuk memakai halaman berhandle lacak-paket."
    }
  ]
}
{% endschema %}
