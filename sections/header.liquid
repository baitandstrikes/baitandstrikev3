<header class="site-header{% if section.settings.transparent and request.page_type == 'index' %} is-transparent{% endif %}{% if section.settings.sticky %} is-sticky{% endif %}" data-header>
<div class="header-main wrap"><div class="header-left"><button class="icon-button mobile-menu" data-menu-toggle aria-expanded="false" aria-controls="MainNav" aria-label="{{ 'general.menu' | t }}">{% render 'icon', name: 'menu' %}</button><button class="icon-button" data-search-toggle aria-expanded="false" aria-controls="HeaderSearch" aria-label="{{ 'general.search' | t }}">{% render 'icon', name: 'search' %}</button></div>
<a href="{{ routes.root_url }}" class="brand" style="--logo-width:{{ section.settings.logo_width }}px">{% if section.settings.logo != blank %}{{ section.settings.logo | image_url: width: 600 | image_tag: widths: '200, 300, 400, 600', loading: 'eager', alt: shop.name }}{% else %}BAIT<span>AND</span>STRIKE{% endif %}</a>
<div class="header-right">{% if shop.customer_accounts_enabled %}<a class="icon-button" href="{{ routes.account_url }}" aria-label="{{ 'general.account' | t }}">{% render 'icon', name: 'account' %}</a>{% endif %}<a href="{{ routes.cart_url }}" class="icon-button cart-trigger" data-open-cart aria-label="{{ 'general.cart' | t }}">{% render 'icon', name: 'bag' %}<span class="cart-count" data-cart-count>{{ cart.item_count }}</span></a></div></div>
<nav id="MainNav" class="main-nav" aria-label="{{ 'general.menu' | t }}"><div class="menu-dismiss"><span>{{ 'general.menu' | t }}</span><button class="icon-button" data-menu-toggle aria-label="{{ 'general.close' | t }}">{% render 'icon', name: 'close' %}</button></div><div class="nav-inner wrap">{% if section.settings.menu != blank %}{% for link in section.settings.menu.links %}{% if link.links != blank %}<details class="mega-item"><summary>{{ link.title | escape }}{% render 'icon', name: 'chevron' %}</summary><div class="mega-panel"><a class="mega-all" href="{{ link.url }}">{{ 'general.view_all' | t }} {{ link.title | escape }} →</a><div class="mega-columns">{% for child in link.links %}<div><a href="{{ child.url }}" class="mega-heading">{{ child.title | escape }}</a>{% if child.links != blank %}<ul>{% for grand in child.links %}<li><a href="{{ grand.url }}">{{ grand.title | escape }}</a></li>{% endfor %}</ul>{% endif %}</div>{% endfor %}</div></div></details>{% else %}<a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title | escape }}</a>{% endif %}{% endfor %}{% else %}<a href="{{ routes.all_products_collection_url }}">{{ 'general.collections' | t }}</a><a href="{{ routes.search_url }}">{{ 'general.search' | t }}</a>{% endif %}</div></nav>
<div id="HeaderSearch" class="header-search" hidden><form action="{{ routes.search_url }}" method="get" class="wrap search-form" role="search"><label class="visually-hidden" for="HeaderQuery">{{ 'general.search' | t }}</label><input id="HeaderQuery" type="search" name="q" autocomplete="off" data-predictive-input aria-controls="PredictiveResults" placeholder="{{ 'general.search' | t }}" required><input type="hidden" name="options[prefix]" value="last"><button class="icon-button" aria-label="{{ 'general.search' | t }}">{% render 'icon', name: 'search' %}</button><button type="button" class="icon-button" data-search-toggle aria-label="{{ 'general.close' | t }}">{% render 'icon', name: 'close' %}</button></form><div id="PredictiveResults" class="predictive-results wrap" aria-live="polite" hidden></div></div>
</header>
{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "Lebar logo",
      "min": 160,
      "max": 360,
      "step": 10,
      "unit": "px",
      "default": 260
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu utama",
      "default": "main-menu"
    },
    {
      "type": "checkbox",
      "id": "transparent",
      "label": "Header transparan di homepage",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "sticky",
      "label": "Header sticky",
      "default": true
    }
  ]
}
{% endschema %}
