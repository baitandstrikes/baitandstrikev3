{% doc %}
  Product-first homepage showcase inspired by large catalogue storefronts.
{% enddoc %}
{% assign highlight_collection = section.settings.collection | default: collections.all %}
<section class="commerce-home" aria-label="{{ section.settings.heading | escape }}">
  <div class="commerce-home__inner wrap">
    <div class="commerce-home__top">
      <div class="commerce-promo" data-slideshow data-autoplay="true" data-delay="6000" aria-roledescription="carousel" aria-label="Promo BAITANDSTRIKE">
        <div class="commerce-promo__slides">
          {% for block in section.blocks %}{% if block.type == 'promo' %}
            <article class="commerce-promo__slide{% if forloop.first %} is-active{% endif %}" data-slide {% unless forloop.first %}inert aria-hidden="true"{% endunless %} {{ block.shopify_attributes }}>
              {% if block.settings.image %}{{ block.settings.image | image_url: width: 900 | image_tag: loading: 'eager', widths: '420, 640, 900', sizes: '(min-width: 990px) 28vw, 100vw', alt: block.settings.title }}{% elsif block.settings.image_url != blank %}<img src="{{ block.settings.image_url | escape }}" width="900" height="900" alt="{{ block.settings.title | escape }}">{% else %}<img src="{{ 'category-1.svg' | asset_url }}" width="900" height="900" alt="">{% endif %}
              <div class="commerce-promo__copy"><p>{{ block.settings.eyebrow | escape }}</p><h2>{{ block.settings.title | escape }}</h2><a class="button" href="{{ block.settings.link | default: routes.all_products_collection_url }}">{{ block.settings.button_label | escape }}</a></div>
            </article>
          {% endif %}{% endfor %}
        </div>
        <button class="commerce-arrow commerce-arrow--prev" data-slide-prev aria-label="Sebelumnya">‹</button><button class="commerce-arrow commerce-arrow--next" data-slide-next aria-label="Berikutnya">›</button>
        <div class="commerce-dots">{% assign promo_index = 0 %}{% for block in section.blocks %}{% if block.type == 'promo' %}<button class="slide-dot{% if promo_index == 0 %} is-active{% endif %}" data-slide-to="{{ promo_index }}" aria-label="Slide {{ promo_index | plus: 1 }}"{% if promo_index == 0 %} aria-current="true"{% endif %}></button>{% assign promo_index = promo_index | plus: 1 %}{% endif %}{% endfor %}</div>
      </div>
      <div class="commerce-highlight" data-carousel>
        <div class="commerce-heading"><div><span>PRODUK PILIHAN BNS</span><h2>{{ section.settings.heading | escape }}</h2></div><div><button data-carousel-prev aria-label="Produk sebelumnya">‹</button><button data-carousel-next aria-label="Produk berikutnya">›</button></div></div>
        <div class="commerce-products" data-carousel-track>
          {% for product in highlight_collection.products limit: section.settings.limit %}
            <article class="commerce-product">
              <a href="{{ product.url }}" class="commerce-product__image">{% if product.featured_image %}{{ product.featured_image | image_url: width: 360 | image_tag: loading: 'lazy', widths: '120, 240, 360', sizes: '150px', alt: product.title }}{% else %}<img src="{{ 'category-2.svg' | asset_url }}" width="160" height="160" alt="">{% endif %}</a>
              <div><p class="commerce-product__vendor">{{ product.vendor | escape }}</p><h3><a href="{{ product.url }}">{{ product.title | escape }}</a></h3><p class="commerce-product__price">{{ product.price | money }}</p><p class="commerce-stock{% unless product.available %} is-out{% endunless %}">{% if product.available %}Ready Stock{% else %}Stok Habis{% endif %}</p></div>
            </article>
          {% else %}<p>Produk akan tampil setelah koleksi dipilih.</p>{% endfor %}
        </div>
      </div>
    </div>
    <div class="commerce-services" aria-label="Layanan BAITANDSTRIKE">
      <a href="/pages/wholesale-registration-form">{% render 'icon', name: 'compare' %}<strong>Minta Penawaran</strong><span>Harga grosir untuk reseller</span></a>
      <a href="/pages/wholesale-registration-form">{% render 'icon', name: 'check' %}<strong>BMT B2B</strong><span>Pemesanan bisnis lebih mudah</span></a>
      <a href="/collections/all">{% render 'icon', name: 'bag' %}<strong>Produk Pilihan</strong><span>Perlengkapan untuk setiap trip</span></a>
      <a href="/pages/contact">{% render 'icon', name: 'account' %}<strong>Bantuan Produk</strong><span>Konsultasi sebelum membeli</span></a>
      <a href="/pages/contact">{% render 'icon', name: 'truck' %}<strong>Pengiriman</strong><span>Informasi kirim seluruh Indonesia</span></a>
      <a href="/pages/faq">{% render 'icon', name: 'shield' %}<strong>Belanja Aman</strong><span>Informasi produk lebih jelas</span></a>
    </div>
  </div>
</section>
{% stylesheet %}
.commerce-home{background:#f2f3f4;padding:18px 0 22px;color:#1d2730}.commerce-home__inner{background:#fff;padding:18px}.commerce-home__top{display:grid;grid-template-columns:minmax(280px,28%) minmax(0,1fr);gap:18px}.commerce-promo{position:relative;min-width:0;overflow:hidden;border-radius:18px;background:#dceaf4}.commerce-promo__slides{height:100%}.commerce-promo__slide{position:relative;height:100%;min-height:360px;overflow:hidden}.commerce-promo__slide:not(.is-active){display:none}.commerce-promo__slide>img{width:100%;height:100%;position:absolute;inset:0;object-fit:cover}.commerce-promo__slide:after{content:'';position:absolute;inset:0;background:linear-gradient(180deg,#062b4366,#062b43cc)}.commerce-promo__copy{position:relative;z-index:1;display:flex;min-height:360px;flex-direction:column;justify-content:flex-end;align-items:center;padding:32px 24px;text-align:center;color:#fff}.commerce-promo__copy p{font-size:11px;font-weight:700;letter-spacing:.14em}.commerce-promo__copy h2{font-size:30px;font-weight:700;line-height:1.12;margin:8px 0 22px}.commerce-promo__copy .button{background:#fcdd16;border-color:#fcdd16;color:#102b3d;border-radius:24px}.commerce-arrow{position:absolute;z-index:2;top:48%;width:42px;height:56px;border:0;background:#fffffff0;font-size:34px;color:#52616b;box-shadow:0 3px 10px #0002}.commerce-arrow--prev{left:0;border-radius:0 6px 6px 0}.commerce-arrow--next{right:0;border-radius:6px 0 0 6px}.commerce-dots{position:absolute;z-index:2;left:0;right:0;bottom:12px;display:flex;justify-content:center;gap:8px}.commerce-dots .slide-dot{border-color:#fff;background:#fff8}.commerce-dots .slide-dot.is-active{background:#fcdd16}.commerce-highlight{min-width:0;padding:2px 0}.commerce-heading{display:flex;align-items:flex-start;justify-content:space-between;margin:0 0 14px}.commerce-heading span{font-size:10px;color:#60717c;font-weight:700;letter-spacing:.1em}.commerce-heading h2{font-size:22px;font-weight:700;letter-spacing:0;margin:2px 0}.commerce-heading button{width:38px;height:38px;border:0;border-radius:4px;background:#f0f1f2;font-size:24px;margin-left:7px}.commerce-products{display:grid;grid-auto-flow:column;grid-auto-columns:minmax(142px,1fr);overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none}.commerce-products::-webkit-scrollbar{display:none}.commerce-product{scroll-snap-align:start;display:grid;grid-template-rows:145px 1fr;min-width:0;padding:6px 12px 10px;border-right:1px solid #e5e8ea}.commerce-product__image{display:grid;place-items:center;min-width:0}.commerce-product__image img{width:100%;height:135px;object-fit:contain}.commerce-product__vendor{font-size:10px;font-weight:700;color:#5f6d75;margin:5px 0}.commerce-product h3{font-size:13px;font-weight:500;line-height:1.35;letter-spacing:0;height:53px;overflow:hidden;margin:0}.commerce-product__price{font-size:15px;color:#d9281c;font-weight:700;margin:6px 0}.commerce-stock{display:inline-block;background:#168c2d;color:#fff;border-radius:4px;padding:3px 7px;font-size:10px;font-weight:700;margin:0}.commerce-stock.is-out{background:#777}.commerce-services{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:12px;margin-top:18px}.commerce-services a{display:grid;grid-template-rows:40px auto auto;place-items:center;min-height:142px;padding:18px 10px;border-radius:14px;background:#e3f0fb;text-align:center;transition:transform .3s ease,box-shadow .3s ease}.commerce-services a:hover{transform:translateY(-3px);box-shadow:0 9px 22px #123f5f16}.commerce-services .icon{width:36px;height:36px;color:#1676bb;stroke-width:1.7}.commerce-services strong{font-size:12px;line-height:1.2;margin-top:5px}.commerce-services span{font-size:10px;line-height:1.3;margin-top:4px;color:#43545e}
@media(max-width:989px){.commerce-home__top{grid-template-columns:1fr}.commerce-promo__slide,.commerce-promo__copy{min-height:340px}.commerce-products{grid-auto-columns:minmax(150px,1fr)}.commerce-services{grid-template-columns:repeat(3,minmax(0,1fr))}}
@media(max-width:749px){.commerce-home{padding:8px 0 14px}.commerce-home__inner{width:100%;padding:10px}.commerce-home__top{gap:15px}.commerce-promo{border-radius:12px}.commerce-promo__slide,.commerce-promo__copy{min-height:315px}.commerce-promo__copy{padding:26px 34px}.commerce-promo__copy h2{font-size:27px}.commerce-highlight{padding:0 2px}.commerce-heading h2{font-size:19px}.commerce-products{grid-auto-columns:43vw}.commerce-product{grid-template-rows:125px 1fr;padding:4px 9px 10px}.commerce-product__image img{height:118px}.commerce-product h3{font-size:12px}.commerce-services{grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}.commerce-services a{min-height:125px;padding:14px 7px}.commerce-services strong{font-size:11px}.commerce-services span{font-size:9px}}
{% endstylesheet %}
{% schema %}
{"name":"Commerce Homepage","settings":[{"type":"collection","id":"collection","label":"Koleksi product highlight"},{"type":"text","id":"heading","label":"Judul produk","default":"Product Highlight"},{"type":"range","id":"limit","label":"Jumlah produk","min":5,"max":12,"step":1,"default":8}],"max_blocks":5,"blocks":[{"type":"promo","name":"Banner promo","settings":[{"type":"image_picker","id":"image","label":"Gambar"},{"type":"url","id":"image_url","label":"URL gambar"},{"type":"text","id":"eyebrow","label":"Teks kecil","default":"PROMO BAITANDSTRIKE"},{"type":"text","id":"title","label":"Judul","default":"Lengkapi trip berikutnya"},{"type":"text","id":"button_label","label":"Tombol","default":"BELANJA SEKARANG"},{"type":"url","id":"link","label":"Tautan"}]}],"presets":[{"name":"Commerce Homepage","blocks":[{"type":"promo"},{"type":"promo"}]}]}
{% endschema %}

