<section class="section wrap business-profile"><div class="align-center narrow" style="margin-inline:auto">{% if section.settings.hero_background %}{{ section.settings.hero_background | image_url: width: 1800 | image_tag: loading: 'eager', widths: '600, 1000, 1800', sizes: '100vw' }}{% endif %}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p><h1>{{ section.settings.heading | escape }}</h1><p>{{ section.settings.hero_text | escape }}</p><div class="business-actions">{% if section.settings.primary_label != blank %}<a class="button" href="{{ section.settings.primary_link | default: routes.all_products_collection_url }}">{{ section.settings.primary_label | escape }}</a>{% endif %}{% if section.settings.secondary_label != blank %}<a class="text-link" href="{{ section.settings.secondary_link | default: '/pages/contact' }}">{{ section.settings.secondary_label | escape }}</a>{% endif %}</div></div><div class="business-intro"><div><p class="eyebrow">{{ section.settings.intro_eyebrow | escape }}</p><h2>{{ section.settings.intro_heading | escape }}</h2></div><div class="rte">{{ section.settings.intro_text }}</div></div><div class="business-grid business-stats">{% for block in section.blocks %}{% if block.type == 'stat' %}<div {{ block.shopify_attributes }}><h2>{{ block.settings.number | escape }}</h2><p>{{ block.settings.label | escape }}</p></div>{% endif %}{% endfor %}</div>{% assign groups = 'service,audience,why' | split: ',' %}{% for group in groups %}{% case group %}{% when 'service' %}{% assign eyebrow = section.settings.services_eyebrow %}{% assign heading = section.settings.services_heading %}{% when 'audience' %}{% assign eyebrow = section.settings.audience_eyebrow %}{% assign heading = section.settings.audience_heading %}{% when 'why' %}{% assign eyebrow = section.settings.why_eyebrow %}{% assign heading = section.settings.why_heading %}{% endcase %}<div class="business-group"><p class="eyebrow">{{ eyebrow | escape }}</p><h2>{{ heading | escape }}</h2><div class="business-grid">{% for block in section.blocks %}{% if block.type == group %}<article {{ block.shopify_attributes }}><p class="eyebrow">{{ block.settings.number | default: block.settings.icon | escape }}</p><h3>{{ block.settings.title | escape }}</h3><p>{{ block.settings.text | escape }}</p></article>{% endif %}{% endfor %}</div></div>{% endfor %}<div class="business-cta align-center"><p class="eyebrow">{{ section.settings.cta_eyebrow | escape }}</p><h2>{{ section.settings.cta_heading | escape }}</h2><p>{{ section.settings.cta_text | escape }}</p>{% if section.settings.cta_label != blank %}<a class="button" href="{{ section.settings.cta_link | default: '/pages/contact' }}">{{ section.settings.cta_label | escape }}</a>{% endif %}</div></section>
{% schema %}
{
  "name": "BNS Business Profile",
