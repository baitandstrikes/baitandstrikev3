        },
        {
          "value": "right center",
          "label": "Right"
        }
      ]
    },
    {
      "type": "range",
      "id": "hero_overlay",
      "label": "Background overlay",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "default": 35
