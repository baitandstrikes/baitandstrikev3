<div class="technique-collections">
  {% for block in section.blocks %}
    {% assign technique_collection = block.settings.collection %}
    <section class="section wrap reveal" data-carousel {{ block.shopify_attributes }}>
      <div class="section-heading">
        <div>
          <p class="eyebrow">PRODUK PILIHAN BNS</p>
          <h2>{{ block.settings.title | escape }}</h2>
        </div>
        <div class="heading-actions">
          {% if technique_collection != blank %}<a class="text-link" href="{{ technique_collection.url }}">{{ 'general.view_all' | t }}</a>{% endif %}
          <button class="icon-button" data-carousel-prev aria-label="{{ 'general.previous' | t }}">{% render 'icon', name: 'arrow' %}</button>
          <button class="icon-button" data-carousel-next aria-label="{{ 'general.next' | t }}">{% render 'icon', name: 'arrow' %}</button>
        </div>
      </div>
      <div class="product-carousel" data-carousel-track>
        {% for product in technique_collection.products limit: 8 %}
          {% render 'product-card', product: product %}
        {% else %}
          <p>{{ 'general.empty' | t }}</p>
        {% endfor %}
      </div>
    </section>
  {% endfor %}
</div>
{% schema %}
{
  "name": "Teknik memancing",
  "max_blocks": 8,
  "blocks": [
    {
      "type": "technique",
      "name": "Koleksi teknik",
      "settings": [
        {"type":"text","id":"title","label":"Teknik"},
        {"type":"collection","id":"collection","label":"Koleksi produk"}
      ]
    }
  ],
  "presets": [{"name":"Teknik memancing"}]
}
{% endschema %}
