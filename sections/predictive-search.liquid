{% if predictive_search.performed %}<div data-predictive-response><h2 class="predictive-heading">{{ 'general.products' | t }}</h2><div class="predictive-grid">{% for product in predictive_search.resources.products %}{% capture listing_card_attributes %}{% render 'listing-card-attributes', product: product, base_class: 'predictive-link' %}{% endcapture %}<a {{ listing_card_attributes }} href="{{ product.url }}">{% if product.featured_image %}{{ product.featured_image | image_url: width: 160 | image_tag: loading: 'lazy' }}{% endif %}<span><small class="predictive-vendor">{{ product.vendor | escape }}</small>{{ product.title | escape }}<br>{{ product.price | money }}</span></a>{% else %}<p>{{ 'general.no_results' | t }}</p>{% endfor %}</div>{% for collection in predictive_search.resources.collections %}<a class="predictive-link" href="{{ collection.url }}">{{ collection.title | escape }}</a>{% endfor %}{% for page in predictive_search.resources.pages %}<a class="predictive-link" href="{{ page.url }}">{{ page.title | escape }}</a>{% endfor %}<a class="text-link" href="{{ routes.search_url }}?q={{ predictive_search.terms | url_encode }}">{{ 'general.all_results' | t }}</a></div>{% endif %}
{% schema %}{"name":"Predictive Search","settings":[]}{% endschema %}
