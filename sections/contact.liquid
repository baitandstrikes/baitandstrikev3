<section class="section contact-page">
  <div class="wrap">
    <header class="contact-page__intro">
      <p class="eyebrow">BAIT&amp;STRIKE SUPPORT</p>
      <h1>{{ page.title | default: section.settings.title | escape }}</h1>
      <div class="contact-page__lead rte">{{ section.settings.text }}{{ page.content }}</div>
    </header>

    <div class="contact-layout contact-page__grid">
      <div class="contact-page__details">
        <section class="contact-page__card">
          <p class="contact-page__eyebrow">VISIT US</p>
          <h2>{{ section.settings.info_title | escape }}</h2>
          {% if section.settings.address != blank %}
            <address>{{ section.settings.address | escape }}</address>
          {% endif %}
          {% if section.settings.phone != blank %}
            <div class="contact-page__detail">
              <span>{{ 'general.phone' | t }}</span>
              <a href="tel:{{ section.settings.phone | remove: ' ' | remove: '-' }}">{{ section.settings.phone | escape }}</a>
            </div>
          {% endif %}
          {% if section.settings.hours != blank %}
            <div class="contact-page__detail">
              <span>OPENING HOURS</span>
              <p>{{ section.settings.hours | escape }}</p>
            </div>
          {% endif %}
          <div class="contact-page__actions">
            {% if section.settings.whatsapp != blank %}
              <a class="button contact-page__whatsapp" href="{{ section.settings.whatsapp }}" target="_blank" rel="noopener noreferrer">{{ section.settings.whatsapp_label | escape }}</a>
            {% endif %}
            {% if section.settings.map_url != blank %}
              <a class="text-link contact-page__directions" href="{{ section.settings.map_url }}" target="_blank" rel="noopener noreferrer">{{ section.settings.map_label | escape }} →</a>
            {% endif %}
          </div>
        </section>
        <p class="contact-page__note">For product, order, or wholesale questions, send us a message and our team will get back to you.</p>
      </div>

      <section class="contact-page__form-card">
        {% if section.settings.form_heading != blank %}
          <h2>{{ section.settings.form_heading | escape }}</h2>
        {% endif %}
        <p class="contact-page__form-note">Fill in the form below and we’ll be in touch.</p>
        {% form 'contact', id: 'ContactForm' %}
          {% if form.posted_successfully? %}
            <p class="contact-page__success" role="status">{{ section.settings.success_message | escape }}</p>
          {% endif %}
          {{ form.errors | default_errors }}
          <div class="contact-page__fields">
            <div class="contact-page__field">
              <label for="ContactName-{{ section.id }}">{{ 'general.name' | t }}</label>
              <input id="ContactName-{{ section.id }}" name="contact[name]" autocomplete="name" value="{{ form.name | default: customer.name | escape }}" required>
            </div>
            <div class="contact-page__field">
              <label for="ContactEmail-{{ section.id }}">{{ 'general.email' | t }}</label>
              <input id="ContactEmail-{{ section.id }}" type="email" name="contact[email]" autocomplete="email" value="{{ form.email | default: customer.email | escape }}" required>
            </div>
            <div class="contact-page__field contact-page__field--full">
              <label for="ContactPhone-{{ section.id }}">{{ 'general.phone' | t }}</label>
              <input id="ContactPhone-{{ section.id }}" type="tel" name="contact[phone]" autocomplete="tel">
            </div>
            <div class="contact-page__field contact-page__field--full">
              <label for="ContactMessage-{{ section.id }}">{{ 'general.message' | t }}</label>
              <textarea id="ContactMessage-{{ section.id }}" name="contact[body]" rows="6" required>{{ form.body | escape }}</textarea>
            </div>
          </div>
          <button class="button contact-page__submit">{{ 'general.submit' | t }}</button>
        {% endform %}
      </section>
    </div>
  </div>
</section>
{% style %}
  .contact-page{padding-block:clamp(48px,7vw,88px)}
  .contact-page__intro{max-width:760px;margin-bottom:clamp(30px,5vw,54px)}
  .contact-page__intro .eyebrow,.contact-page__eyebrow{margin-bottom:12px;color:#167ab6;font-size:11px;font-weight:700;letter-spacing:.16em}
  .contact-page__intro h1{margin-bottom:16px;font-size:clamp(38px,5vw,58px);letter-spacing:-.035em}
  .contact-page__lead{max-width:650px;margin:0;color:#59666e;font-size:16px;line-height:1.75}
  .contact-page__lead p{margin:0}
  .contact-page .contact-page__grid{grid-template-columns:minmax(0,.85fr) minmax(0,1.15fr);gap:clamp(24px,5vw,68px);align-items:start;margin-top:0}
  .contact-page__card,.contact-page__form-card{padding:clamp(24px,3.5vw,40px);border:1px solid #e1e8ec;border-radius:10px;background:#fff}
  .contact-page__card{background:#f5f8fa}
  .contact-page__card h2,.contact-page__form-card h2{margin:0 0 18px;font-size:clamp(22px,2.4vw,28px);font-weight:500;letter-spacing:-.02em}
  .contact-page__card address{margin-bottom:24px;color:#4c5a63;font-size:14px;font-style:normal;line-height:1.75}
  .contact-page__detail{margin-top:18px;padding-top:17px;border-top:1px solid #dfe6ea}
  .contact-page__detail>span{display:block;margin-bottom:5px;color:#6c7a83;font-size:10px;font-weight:700;letter-spacing:.12em;text-transform:uppercase}
  .contact-page__detail>a,.contact-page__detail p{margin:0;color:#263843;font-size:14px;line-height:1.7}
  .contact-page__detail>a{font-weight:600}
  .contact-page__actions{display:flex;flex-wrap:wrap;align-items:center;gap:14px 20px;margin-top:26px}
  .contact-page__whatsapp{min-height:46px;padding:12px 20px;background:#167a58;border-color:#167a58}
  .contact-page__whatsapp:hover{background:#106346;border-color:#106346}
  .contact-page__directions{font-size:12px}
  .contact-page__note{margin:16px 4px 0;color:#6c7a83;font-size:12px;line-height:1.7}
  .contact-page__form-card{box-shadow:0 14px 40px #123f5f0c}
  .contact-page__form-note{margin:-8px 0 24px;color:#6c7a83;font-size:13px}
  .contact-page__fields{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px 16px}
  .contact-page__field{min-width:0}
  .contact-page__field--full{grid-column:1/-1}
  .contact-page__field label{display:block;margin-bottom:7px;font-size:12px;font-weight:600}
  .contact-page__field input,.contact-page__field textarea{display:block;width:100%;min-width:0;margin:0;padding:12px 14px;border:1px solid #d4dde2;border-radius:5px;background:#fff;color:#14212b;font-size:14px;line-height:1.5}
  .contact-page__field input{min-height:48px}
  .contact-page__field textarea{min-height:150px;resize:vertical}
  .contact-page__field input:focus,.contact-page__field textarea:focus{border-color:#167ab6;outline:2px solid #167ab633;outline-offset:1px}
  .contact-page__submit{min-width:150px;margin-top:20px}
  .contact-page__success{padding:12px 14px;border:1px solid #b8dfca;border-radius:5px;background:#eef9f2;color:#175d36}
  @media(max-width:749px){
    .contact-page{padding-block:42px}
    .contact-page__intro{margin-bottom:28px}
    .contact-page__intro h1{margin-bottom:12px;font-size:36px}
    .contact-page__lead{font-size:14px}
    .contact-page .contact-page__grid{grid-template-columns:minmax(0,1fr);gap:18px}
    .contact-page__card,.contact-page__form-card{padding:22px 18px;border-radius:8px}
    .contact-page__card h2,.contact-page__form-card h2{font-size:23px}
    .contact-page__fields{grid-template-columns:minmax(0,1fr);gap:15px}
    .contact-page__field--full{grid-column:auto}
    .contact-page__field input,.contact-page__field textarea{font-size:16px}
    .contact-page__submit{width:100%}
    .contact-page__actions{align-items:flex-start;flex-direction:column;gap:14px}
  }
{% endstyle %}
{% schema %}
{
  "name": "Contact",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Judul",
      "default": "Hubungi Kami"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Pengantar",
      "default": "<p>Hubungi tim BNS untuk pertanyaan produk dan kerja sama bisnis.</p>"
    },
    {
      "type": "text",
      "id": "info_title",
      "label": "Judul alamat",
      "default": "BAITANDSTRIKE"
    },
    {
      "type": "text",
      "id": "address",
      "label": "Alamat",
      "default": "Jl. Makaliwe Raya No.36, Grogol, Jakarta Barat 11450"
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Telepon",
      "default": "0877-9536-1519"
    },
    {
      "type": "text",
      "id": "hours",
      "label": "Jam operasional",
      "default": "Senin–Jumat 09.00–17.00 · Sabtu 09.00–13.30"
    },
    {
      "type": "url",
      "id": "map_url",
      "label": "Tautan Google Maps"
    },
    {
      "type": "text",
      "id": "map_label",
      "label": "Teks tautan peta",
      "default": "Lihat lokasi"
    },
    {
      "type": "url",
      "id": "whatsapp",
      "label": "WhatsApp"
    },
    {
      "type": "text",
      "id": "whatsapp_label",
      "label": "Tombol WhatsApp",
      "default": "CHAT ON WHATSAPP"
    },
    {
      "type": "text",
      "id": "form_heading",
      "label": "Judul formulir",
      "default": "Send Us Your Question"
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Pesan berhasil",
      "default": "Thank you. Your message has been sent."
    }
  ]
}
{% endschema %}
