<section class="section wrap reveal"><div class="section-heading"><h2>{{ section.settings.title | escape }}</h2></div><div class="collection-tiles">{% for block in section.blocks %}{% assign c = block.settings.collection %}<a class="collection-tile" href="{{ block.settings.link | default: c.url | default: routes.all_products_collection_url }}" {{ block.shopify_attributes }}>{% assign image = block.settings.image | default: c.featured_image %}{% if image %}{{ image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '300, 450, 600, 900', sizes: '(min-width: 750px) 25vw, 50vw' }}{% elsif block.settings.image_url != blank %}<img src="{{ block.settings.image_url | escape }}" width="600" height="800" loading="lazy" alt="{{ block.settings.title | escape }}">{% else %}{% if forloop.index <= 4 %}{% assign artwork = 'category-' | append: forloop.index | append: '.svg' %}<img src="{{ artwork | asset_url }}" width="600" height="800" alt="" loading="lazy">{% else %}{{ 'collection-1' | placeholder_svg_tag: 'placeholder' }}{% endif %}{% endif %}<div class="tile-shade"></div><div class="tile-copy"><h3>{{ block.settings.title | default: c.title | escape }}</h3><span>{{ block.settings.button_label | escape }} →</span></div></a>{% endfor %}</div></section>
{% schema %}
{
  "name": "Collection Tiles",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Judul",
      "default": "Pilih perlengkapanmu"
    }
  ],
  "max_blocks": 8,
  "blocks": [
    {
      "type": "collection",
      "name": "Kategori",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Koleksi Shopify"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Gambar alternatif"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Judul alternatif"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Teks tautan",
          "default": "Jelajahi"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Tautan alternatif"
        },
        {
          "type": "url",
          "id": "image_url",
          "label": "Gambar dari toko referensi"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection Tiles"
    }
  ]
}
{% endschema %}
