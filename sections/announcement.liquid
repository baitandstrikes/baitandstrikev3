{% if section.settings.text != blank %}<div class="announcement" style="--announcement-bg:{{ section.settings.background }};--announcement-ink:{{ section.settings.foreground }}">{% if section.settings.link != blank %}<a href="{{ section.settings.link }}">{{ section.settings.text | escape }}</a>{% else %}<span>{{ section.settings.text | escape }}</span>{% endif %}</div>{% endif %}
{% schema %}
{
  "name": "Announcement",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Teks",
      "default": "BAITANDSTRIKE · Peralatan mancing untuk setiap petualangan"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Tautan"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Latar",
      "default": "#252525"
    },
    {
      "type": "color",
      "id": "foreground",
      "label": "Teks",
      "default": "#FFFFFF"
    }
  ]
}
{% endschema %}
