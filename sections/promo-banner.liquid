<section id="PartnerPromo" class="promo-banner reveal{% if section.settings.asset != blank %} promo-banner--image{% endif %}" style="--promo-bg:{{ section.settings.background }};--promo-ink:{{ section.settings.foreground }}{% if section.settings.asset != blank %};--promo-image:url('{{ section.settings.asset | asset_url }}'){% endif %}">
  <div class="wrap">
    {% if section.settings.eyebrow != blank %}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
    <h2>{{ section.settings.title | escape }}</h2>
    <div class="rte">{{ section.settings.text }}</div>
    {% if section.settings.link != blank %}
      <a class="button{% if section.settings.asset != blank %} promo-banner__cta{% else %} button-white{% endif %}" href="{{ section.settings.link | escape }}"{% if section.settings.asset != blank %} target="_blank" rel="noopener noreferrer" style="font-weight:800!important;letter-spacing:0!important"{% endif %}>
        {% if section.settings.asset != blank %}<span class="promo-banner__icon">{% render 'icon', name: 'whatsapp' %}</span>{% endif %}
        {{ section.settings.button_label | escape }}
      </a>
    {% endif %}
  </div>
</section>
{% stylesheet %}
body.page-index .promo-banner--image{position:relative;display:flex;min-height:546px;align-items:center;margin-top:40px;padding:70px 20px;background-color:var(--promo-bg);background-image:linear-gradient(90deg,rgba(6,43,67,.91) 0%,rgba(6,43,67,.76) 44%,rgba(6,43,67,.31) 100%),var(--promo-image);background-size:cover;background-position:center;text-align:left;color:var(--promo-ink)}
.promo-banner--image .wrap{position:relative;z-index:1;width:100%;max-width:1180px;margin:0 auto}
.promo-banner--image .eyebrow{display:none}
#PartnerPromo .wrap{transform:translateY(27px)}
#PartnerPromo h2{max-width:520px;margin:0 0 50px;font-size:clamp(34px,3vw,44px);font-weight:700;line-height:1.08;text-transform:uppercase}
#PartnerPromo .rte{width:500px;max-width:100%;margin:0 0 93px!important;font-size:16px;line-height:1.7}
#PartnerPromo .rte p{margin:0;text-align:left}
.promo-banner__cta{display:inline-flex;min-height:54px;align-items:center;justify-content:center;gap:12px;padding:13px 28px;border:0;border-radius:999px;background:#20bd5a;color:#fff;font-size:15px;font-weight:800;text-transform:uppercase}
.promo-banner__icon{display:grid;width:40px;height:40px;flex:0 0 40px;place-items:center;border:2px solid currentColor;border-radius:50%}
.promo-banner__icon .icon{width:23px;height:23px}
.promo-banner--image .wrap{width:calc(100% - 48px);max-width:1160px}
body.page-index .promo-banner--image .wrap{padding-left:48px}
body.page-index .promo-banner--image .promo-banner__cta{width:354px;max-width:100%;min-height:68px;flex-direction:row-reverse;justify-content:space-between;padding:13px 14px 13px 60px;border-radius:34px;background:#20bd2f;color:#fff;font-size:16px}
body.page-index .whatsapp-float{display:none!important}
@media(max-width:749px){#PartnerPromo{min-height:390px;margin-top:24px;padding:52px 18px;background-position:60% center}#PartnerPromo .wrap{width:100%;padding-left:0;transform:none}#PartnerPromo h2{margin-bottom:18px;font-size:34px}#PartnerPromo .rte{width:100%;max-width:100%;margin-bottom:28px!important;font-size:14px}#PartnerPromo .promo-banner__cta{width:220px;max-width:100%;min-height:52px;justify-content:space-between;padding:6px 10px 6px 18px;font-size:12px}#PartnerPromo .promo-banner__icon{width:36px;height:36px;flex-basis:36px}#PartnerPromo .promo-banner__icon .icon{width:21px;height:21px}}
{% endstylesheet %}
{% schema %}
{
  "name": "Promo Banner",
  "settings": [
    {"type":"text","id":"eyebrow","label":"Teks kecil","default":"BNS PARTNERS"},
    {"type":"text","id":"title","label":"Judul","default":"SIAP JADI MITRA?"},
    {"type":"richtext","id":"text","label":"Isi","default":"<p>Dapatkan produk berkualitas dengan harga kompetitif dan pendampingan bisnis untuk membantu toko pancing Anda tumbuh bersama BNS Store.</p>"},
    {"type":"text","id":"button_label","label":"Teks tombol","default":"KONSULTASI GRATIS"},
    {"type":"url","id":"link","label":"Tautan"},
    {"type":"text","id":"asset","label":"Nama asset gambar tema"},
    {"type":"color","id":"background","label":"Latar","default":"#123F5F"},
    {"type":"color","id":"foreground","label":"Teks","default":"#FFFFFF"}
  ],
  "presets": [{"name":"Promo Banner"}]
}
{% endschema %}
