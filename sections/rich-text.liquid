<section class="section rich-text wrap reveal align-center"><p class="eyebrow">{{ section.settings.eyebrow | escape }}</p><h2>{{ section.settings.title | escape }}</h2><div class="rte">{{ section.settings.text }}</div>{% if section.settings.link != blank %}<a class="text-link" href="{{ section.settings.link }}">{{ section.settings.button_label | escape }} →</a>{% endif %}</section>
{% schema %}
{
  "name": "Rich Text",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Teks kecil",
      "default": "BAITANDSTRIKE"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Judul",
      "default": "Untuk kamu yang selalu ingin kembali ke air."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Isi",
      "default": "<p>Dari trip pertama sampai strike berikutnya. Temukan joran, reel, umpan, dan aksesori untuk melengkapi perlengkapan mancing kamu.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Teks tautan",
      "default": "Kenali BNS"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Tautan"
    }
  ],
  "presets": [
    {
      "name": "Rich Text"
    }
  ]
}
{% endschema %}
