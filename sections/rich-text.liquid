<section class="section rich-text wrap reveal align-center{% if section.settings.background_video != blank %} rich-text--video{% endif %}" style="--intro-shade:{{ section.settings.video_overlay | divided_by: 100.0 }}">
  {% if section.settings.background_video != blank %}
    <bns-intro-video>
      <div class="intro-video-media" aria-hidden="true">{{ section.settings.background_video | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true, preload: 'metadata', image_size: '1600x', tabindex: '-1' }}</div>
      <button type="button" class="intro-video-toggle" data-pause-label="{{ section.settings.pause_label | escape }}" data-play-label="{{ section.settings.play_label | escape }}" aria-label="{{ section.settings.pause_label | escape }}" hidden><span aria-hidden="true">Ⅱ</span></button>
    </bns-intro-video>
  {% endif %}
  <div class="intro-video-copy"><p class="eyebrow">{{ section.settings.eyebrow | escape }}</p><h2>{{ section.settings.title | escape }}</h2><div class="rte">{{ section.settings.text }}</div>{% if section.settings.link != blank %}<a class="text-link" href="{{ section.settings.link }}">{{ section.settings.button_label | escape }} →</a>{% endif %}</div>
</section>
{% stylesheet %}
  .rich-text--video{position:relative;isolation:isolate;overflow:hidden;background:#182b36;color:#fff;width:100%;max-width:none;margin-inline:0;min-height:clamp(520px,78vh,960px);display:flex;align-items:center;justify-content:center;padding-block:clamp(56px,8vh,110px)}
  .rich-text--video .intro-video-copy{position:relative;z-index:1;width:min(100% - 48px,900px);margin-inline:auto;padding:20px 24px 28px}
  .rich-text--video .rte,.rich-text--video .text-link{color:inherit}
  .intro-video-media{position:absolute;inset:0;z-index:-1;pointer-events:none}
  .intro-video-media:after{content:'';position:absolute;inset:0;background:rgba(0,0,0,var(--intro-shade,.55))}
  .intro-video-media video{width:100%;height:100%;object-fit:cover}
  .intro-video-toggle{position:absolute;right:12px;bottom:12px;z-index:2;width:44px;height:44px;display:grid;place-items:center;border:1px solid #fff9;border-radius:50%;background:#0005;color:#fff}
  .intro-video-toggle[hidden]{display:none}
  .intro-video-toggle:focus-visible{outline:2px solid #fff;outline-offset:3px}
  @media(max-width:749px){.rich-text--video{min-height:clamp(500px,72svh,760px);padding-block:44px}.rich-text--video .intro-video-copy{width:calc(100% - 36px);padding:18px 0 28px}.rich-text--video .eyebrow{margin-bottom:16px}.rich-text--video h2{font-size:clamp(27px,7vw,36px);line-height:1.2}}
{% endstylesheet %}
{% javascript %}
  if (!customElements.get('bns-intro-video')) customElements.define('bns-intro-video', class extends HTMLElement {
    connectedCallback() {
      this.frame = requestAnimationFrame(() => {
        const video = this.querySelector('video'), button = this.querySelector('button');
        if (!video || !button) return;
        this.events = new AbortController();
        const options = {signal:this.events.signal};
        const sync = () => {button.setAttribute('aria-label',video.paused ? button.dataset.playLabel : button.dataset.pauseLabel);button.querySelector('span').textContent=video.paused ? '▶' : 'Ⅱ';};
        video.muted = true;
        if (matchMedia('(prefers-reduced-motion: reduce)').matches) {video.autoplay=false;video.pause();}
        button.hidden = false;
        button.addEventListener('click', () => {if(video.paused) video.play().catch(sync); else video.pause();}, options);
        video.addEventListener('play',sync,options);video.addEventListener('pause',sync,options);sync();
      });
    }
    disconnectedCallback() {cancelAnimationFrame(this.frame);this.events?.abort();}
  });
{% endjavascript %}
{% schema %}
{
  "name": "Rich Text",
  "settings": [
    {"type":"video","id":"background_video","label":"Video background","info":"Pilih atau upload video. Video diputar berulang tanpa suara."},
    {"type":"range","id":"video_overlay","label":"Tingkat gelap background","min":30,"max":80,"step":5,"unit":"%","default":55},
    {"type":"text","id":"pause_label","label":"Label tombol jeda","default":"Jeda video"},
    {"type":"text","id":"play_label","label":"Label tombol putar","default":"Putar video"},
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Teks kecil",
      "default": "BAITANDSTRIKE"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Judul",
      "default": "Untuk kamu yang selalu ingin kembali ke air."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Isi",
      "default": "<p>Dari trip pertama sampai strike berikutnya. Temukan joran, reel, umpan, dan aksesori untuk melengkapi perlengkapan mancing kamu.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Teks tautan",
      "default": "Kenali BNS"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Tautan"
    }
  ],
  "presets": [
    {
      "name": "Rich Text"
    }
  ]
}
{% endschema %}

