<dialog id="CartDrawer" class="cart-drawer" aria-labelledby="CartDrawerTitle"><div class="drawer-heading"><h2 id="CartDrawerTitle">{{ 'general.cart' | t }} <small>{{ 'cart.count' | t: count: cart.item_count }}</small></h2><button class="icon-button" data-close-dialog aria-label="{{ 'general.close' | t }}">{% render 'icon', name: 'close' %}</button></div><div data-cart-content data-count="{{ cart.item_count }}">{% if cart.empty? %}<div class="empty-cart"><p>{{ 'cart.empty' | t }}</p><a class="button" href="{{ routes.all_products_collection_url }}">{{ 'general.continue' | t }}</a></div>{% else %}<div class="drawer-lines">{% render 'cart-lines', cart: cart %}</div><form action="{{ routes.cart_url }}" method="post" class="drawer-bottom"><label for="DrawerNote">{{ 'cart.note' | t }}</label><textarea id="DrawerNote" name="note" rows="2">{{ cart.note | escape }}</textarea>{% for discount in cart.cart_level_discount_applications %}<p>{{ discount.title | escape }} −{{ discount.total_allocated_amount | money }}</p>{% endfor %}<div class="subtotal"><span>{{ 'cart.subtotal' | t }}</span><strong>{{ cart.total_price | money }}</strong></div><p class="cart-tax-note">{{ 'cart.taxes' | t }}</p><button class="button checkout-button" name="checkout">{{ 'cart.checkout' | t }} →</button><button type="button" class="button button-white" data-tools-open="quote" aria-haspopup="dialog" aria-controls="ShoppingTools">{{ 'tools.quote' | t }}</button><a class="text-link" href="{{ routes.cart_url }}">{{ 'cart.title' | t }}</a></form>{% endif %}</div><p class="form-error drawer-error" data-cart-error role="alert" hidden></p></dialog>
{% schema %}
{
  "name": "Cart Drawer",
  "settings": []
}
{% endschema %}
