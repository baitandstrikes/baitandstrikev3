<dialog id="CartDrawer" class="cart-drawer" aria-labelledby="CartDrawerTitle"><div class="drawer-heading"><h2 id="CartDrawerTitle">{{ 'general.cart' | t }} <small>{{ 'cart.count' | t: count: cart.item_count }}</small></h2><a class="cart-drawer__continue" href="{{ routes.all_products_collection_url }}">{{ 'general.continue' | t }}</a></div><div data-cart-content data-count="{{ cart.item_count }}">{% if cart.empty? %}<div class="empty-cart"><p>{{ 'cart.empty' | t }}</p><a class="button" href="{{ routes.all_products_collection_url }}">{{ 'general.continue' | t }}</a></div>{% else %}<div class="drawer-lines">{% render 'cart-lines', cart: cart %}</div><form action="{{ routes.cart_url }}" method="post" class="drawer-bottom"><label for="DrawerNote">{{ 'cart.note' | t }}</label><textarea id="DrawerNote" name="note" rows="2">{{ cart.note | escape }}</textarea>{% for discount in cart.cart_level_discount_applications %}<p>{{ discount.title | escape }} −{{ discount.total_allocated_amount | money }}</p>{% endfor %}<div class="subtotal"><span>{{ 'cart.subtotal' | t }}</span><strong>{{ cart.total_price | money }}</strong></div><p class="cart-tax-note">{{ 'cart.taxes' | t }}</p><button class="button checkout-button" name="checkout">{{ 'cart.checkout' | t }} →</button><a class="text-link" href="{{ routes.cart_url }}">{{ 'cart.title' | t }}</a></form>{% endif %}</div><p class="form-error drawer-error" data-cart-error role="alert" hidden></p></dialog>
{% stylesheet %}
#CartDrawer .drawer-heading{gap:12px}
#CartDrawer .drawer-heading h2{flex:1;min-width:0}
#CartDrawer .cart-drawer__continue{display:inline-flex;flex:0 0 auto;align-items:center;justify-content:center;min-height:44px;padding:8px 12px;border:1px solid var(--accent,#3282c0);border-radius:4px;color:var(--accent,#3282c0);font-size:13px;font-weight:600;line-height:1.25;text-align:center;white-space:nowrap;transition:background .2s,color .2s}
#CartDrawer .cart-drawer__continue:hover{background:var(--accent,#3282c0);color:#fff}
@media(max-width:749px){#CartDrawer .drawer-heading{gap:8px;padding:16px 14px}#CartDrawer .drawer-heading h2{font-size:20px}#CartDrawer .cart-drawer__continue{min-height:42px;padding:7px 9px;font-size:12px}}
{% endstylesheet %}
{% schema %}
{
  "name": "Cart Drawer",
  "settings": []
}
{% endschema %}
