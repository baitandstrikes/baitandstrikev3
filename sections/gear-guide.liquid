<section class="section gear-guide"><div class="wrap"><div class="section-heading"><h2>{{ section.settings.title | escape }}</h2></div><div class="gear-guide-grid">{% for block in section.blocks %}<article {{ block.shopify_attributes }}><details><summary>{{ block.settings.title | escape }}</summary><div class="rte">{{ block.settings.text }}</div><a class="text-link" href="{{ block.settings.collection.url | default: routes.all_products_collection_url }}">{{ 'tools.view_gear' | t }} →</a></details></article>{% endfor %}</div></div></section>
{% schema %}{"name":"Panduan perlengkapan","settings":[{"type":"text","id":"title","label":"Judul","default":"Panduan memilih perlengkapan"}],"max_blocks":6,"blocks":[{"type":"guide","name":"Panduan","settings":[{"type":"text","id":"title","label":"Judul"},{"type":"richtext","id":"text","label":"Isi"},{"type":"collection","id":"collection","label":"Koleksi terkait"}]}],"presets":[{"name":"Panduan perlengkapan"}]}{% endschema %}
