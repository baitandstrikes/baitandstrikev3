{% assign v = product.selected_or_first_available_variant %}
<section class="section wrap product-root product-detail-catalog" data-product-root data-section-id="{{ section.id }}" data-product-url="{{ product.url }}">
  <nav class="breadcrumbs" aria-label="{{ 'general.menu' | t }}">
    <a href="{{ routes.root_url }}">{{ 'general.home' | t }}</a><span>/</span>
    <a href="{{ routes.all_products_collection_url }}">Produk</a><span>/</span>
    <span>{{ product.title | escape }}</span>
  </nav>

  <header class="product-detail-heading">
    <div>
      <h1>{{ product.title | escape }}</h1>
      <a class="product-buy-jump text-link" href="#ProductBuy-{{ section.id }}">Pilih varian / beli</a>
      <p>#Grup produk {{ product.id }}</p>
    </div>
    <button class="text-link" type="button" data-share="{{ shop.url }}{{ product.url }}">Bagikan ↗</button>
  </header>

  <div class="product-layout product-detail-layout">
    <div class="product-gallery">
      <div class="gallery-main" data-gallery-main>
        {% assign selected_media = v.featured_media | default: product.featured_media %}
        {% for media in product.media %}
          <div class="gallery-item{% if media.id == selected_media.id %} is-active{% endif %}" data-media-id="{{ media.id }}">
            {% case media.media_type %}
              {% when 'image' %}<button type="button" class="zoom-trigger" data-zoom="{{ media | image_url: width: 2000 }}" aria-label="{{ 'general.zoom' | t }}">{{ media | image_url: width: 1400 | image_tag: loading: 'eager', widths: '400, 700, 1000, 1400', sizes: '(min-width:990px) 44vw, 100vw' }}</button>
              {% when 'video' %}{{ media | video_tag: controls: true, image_size: '1000x', preload: 'metadata' }}
              {% when 'external_video' %}{{ media | external_video_tag }}
              {% when 'model' %}{{ media | model_viewer_tag: reveal: 'interaction', toggleable: true }}
            {% endcase %}
          </div>
        {% else %}
          {{ 'product-1' | placeholder_svg_tag: 'placeholder' }}
        {% endfor %}
      </div>
      {% if product.media.size > 1 %}
        <p class="gallery-count" aria-hidden="true">{{ product.media.size }} foto / video</p>
        <div class="gallery-thumbs">
          {% for media in product.media %}<button type="button" data-gallery-select="{{ media.id }}" aria-label="{{ 'product.media' | t }} {{ forloop.index }}" aria-pressed="{% if media.id == selected_media.id %}true{% else %}false{% endif %}">{{ media.preview_image | image_url: width: 180 | image_tag: loading: 'lazy', widths: '90, 180', sizes: '72px' }}</button>{% endfor %}
        </div>
      {% endif %}
    </div>

    <div class="product-info product-detail-info{% unless customer %} wholesale-off{% endunless %}">
      <div class="product-detail-summary">
        {% if section.settings.show_vendor and product.vendor != blank %}<div class="product-detail-row"><span>Merek</span><strong><a href="{{ routes.search_url }}?q={{ product.vendor | url_encode }}">{{ product.vendor | escape }}</a></strong></div>{% endif %}
        <div class="product-detail-row product-detail-price"{% if customer %} data-wholesale-sync{% endif %}><span>Harga</span>{% if v != blank %}{% render 'price', product: product, variant: v %}{% else %}<p class="price">{{ 'product.unavailable' | t }}</p>{% endif %}</div>
        <div class="product-detail-row"><span>Ketersediaan</span><strong class="product-detail-stock{% unless v.available %} is-sold-out{% endunless %}">{% if v.available %}{% if v.inventory_management != blank %}Stok: {{ v.inventory_quantity | at_least: 0 }}{% else %}Ready Stock{% endif %}{% else %}Stok Habis{% endif %}</strong></div>
        <div class="product-detail-row"><span>SKU</span><strong class="product-sku">{% if v.sku != blank %}{{ v.sku | escape }}{% else %}-{% endif %}</strong></div>
      </div>

      {% if product.variants.size > 1 %}
        <details class="product-stock-breakdown">
          <summary>Lihat stok tiap varian</summary>
          <ul>
            {% for stock_variant in product.variants %}
              <li><span>{{ stock_variant.title | escape }}</span><strong>{% if stock_variant.inventory_management != blank %}Stok: {{ stock_variant.inventory_quantity | at_least: 0 }}{% elsif stock_variant.available %}Ready Stock{% else %}Stok Habis{% endif %}</strong></li>
            {% endfor %}
          </ul>
        </details>
      {% endif %}
      {% if section.settings.bulk_order %}{% render 'bulk-order', product: product, section_id: section.id %}{% endif %}
      {% for block in section.blocks %}{% if block.type == '@app' %}<div class="product-app-blocks" {{ block.shopify_attributes }}>{% render block %}</div>{% endif %}{% endfor %}
      <div id="ProductBuy-{{ section.id }}" class="product-buy-target" tabindex="-1">
        {% render 'product-form', product: product, section_id: section.id %}
      </div>

      <div class="product-detail-assurance">
        <div><strong>Produk resmi BAIT&amp;STRIKE</strong><span>Produk terpilih dengan informasi yang jelas.</span></div>
        <div><strong>Pengiriman seluruh Indonesia</strong><span>Estimasi pengiriman tampil saat checkout.</span></div>
      </div>

      <div class="product-detail-specs">
        <h2>Spesifikasi</h2>
        <dl>
          {% if product.vendor != blank %}<div><dt>Merek</dt><dd>{{ product.vendor | escape }}</dd></div>{% endif %}
          {% for option in product.options_with_values %}<div><dt>{{ option.name | escape }}</dt><dd>{{ option.values | map: 'name' | join: ', ' | default: option.values | join: ', ' }}</dd></div>{% endfor %}
          <div><dt>Pilihan produk</dt><dd>{{ product.variants.size }} varian</dd></div>
        </dl>
      </div>

      {% render 'tool-product-data', product: product %}
      {% render 'b2b-context' %}
    </div>
  </div>

  <section class="product-information-catalog" aria-labelledby="information-heading-{{ section.id }}">
    <h2 id="information-heading-{{ section.id }}">Informasi Produk</h2>
    <div class="rte">{{ product.description }}</div>
  </section>

  <div class="product-detail-extras">
    {% for block in section.blocks %}
      {% case block.type %}
        {% when 'text' %}<div class="rte product-extra" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
        {% when 'accordion' %}<details class="product-accordion" {{ block.shopify_attributes }}><summary>{{ block.settings.heading | escape }}{% render 'icon', name: 'plus' %}</summary><div class="rte">{{ block.settings.text }}{{ block.settings.page.content }}</div></details>
      {% endcase %}
    {% endfor %}
  </div>
</section>
{% assign published_reviews = product.metafields.custom.bns_reviews.value %}
{% assign review_count = 0 %}
{% assign rating_total = 0 %}
{% capture review_cards %}
  {% for entry in published_reviews %}
    {% assign rating = entry.rating.value %}
    {% if rating == blank or rating < 1 or rating > 5 or entry.reviewer.value == blank or entry.body.value == blank %}{% continue %}{% endif %}
    {% assign review_count = review_count | plus: 1 %}
    {% assign rating_total = rating_total | plus: rating %}
    <li>
      <strong>{{ entry.reviewer.value | escape }}</strong>
      <span aria-label="{{ rating }} dari 5 bintang"> · {{ rating }}/5</span>
      <p>{{ entry.body.value | escape | newline_to_br }}</p>
    </li>
  {% endfor %}
{% endcapture %}
{% if review_count > 0 %}
  {% assign average_rating = rating_total | times: 1.0 | divided_by: review_count | round: 2 %}
{% endif %}

<section class="section wrap bns-product-reviews" aria-labelledby="ProductReviews-{{ section.id }}">
  <h2 id="ProductReviews-{{ section.id }}">Ulasan produk</h2>
  {% if review_count > 0 %}
    <p><strong>{{ average_rating }}/5</strong> dari {{ review_count }} ulasan</p>
    <ul class="bns-product-reviews__list">{{ review_cards }}</ul>
  {% else %}
    <p>Belum ada ulasan untuk produk ini.</p>
  {% endif %}

  {% assign review_form_id = 'ProductReviewForm-' | append: section.id %}
  {% form 'contact', id: review_form_id, class: 'bns-product-reviews__form' %}
    <h3>Tulis ulasan</h3>
    {% if form.posted_successfully? %}
      <p role="status">Terima kasih! Ulasanmu sudah diterima dan akan diperiksa sebelum ditampilkan.</p>
    {% else %}
      {{ form.errors | default_errors }}
      <input type="hidden" name="contact[Jenis kiriman]" value="Ulasan produk">
      <input type="hidden" name="contact[Produk]" value="{{ product.title | escape }}">
      <input type="hidden" name="contact[ID produk]" value="{{ product.id }}">
      <input type="hidden" name="contact[URL produk]" value="{{ shop.url }}{{ product.url }}">
      <label for="{{ review_form_id }}-name">Nama tampilan</label>
      <input id="{{ review_form_id }}-name" name="contact[name]" type="text" autocomplete="name" maxlength="80" required>
      <label for="{{ review_form_id }}-email">Email</label>
      <input id="{{ review_form_id }}-email" name="contact[email]" type="email" autocomplete="email" required aria-describedby="{{ review_form_id }}-privacy">
      <small id="{{ review_form_id }}-privacy">Email digunakan untuk moderasi dan tidak ditampilkan.</small>
      <label for="{{ review_form_id }}-rating">Rating</label>
      <select id="{{ review_form_id }}-rating" name="contact[Rating]" required>
        <option value="" selected disabled>Pilih rating</option>
        {% for stars in (1..5) %}
          <option value="{{ stars }}">{{ stars }} dari 5 bintang</option>
        {% endfor %}
      </select>
      <label for="{{ review_form_id }}-body">Ulasanmu</label>
      <textarea id="{{ review_form_id }}-body" name="contact[body]" rows="4" maxlength="1500" required></textarea>
      <button class="button" type="submit">Kirim ulasan</button>
    {% endif %}
  {% endform %}
</section>

{% assign product_schema = product | structured_data | strip %}
{% if review_count > 0 %}
  {% capture review_properties %}
    {% unless product_schema contains '"aggregateRating"' %}
      "aggregateRating": {"@type":"AggregateRating","ratingValue":{{ average_rating | json }},"reviewCount":{{ review_count | json }},"bestRating":5,"worstRating":1},
    {% endunless %}
    {% unless product_schema contains '"review"' %}
      "review": [
        {% assign emitted_reviews = 0 %}
        {% for entry in published_reviews %}
          {% assign rating = entry.rating.value %}
          {% if rating == blank or rating < 1 or rating > 5 or entry.reviewer.value == blank or entry.body.value == blank %}{% continue %}{% endif %}
          {% if emitted_reviews > 0 %},{% endif %}
          {"@type":"Review","author":{"@type":"Person","name":{{ entry.reviewer.value | json | replace: '<', '\u003c' }}},"reviewRating":{"@type":"Rating","ratingValue":{{ rating | json }},"bestRating":5,"worstRating":1},"reviewBody":{{ entry.body.value | json | replace: '<', '\u003c' }}}
          {% assign emitted_reviews = emitted_reviews | plus: 1 %}
        {% endfor %}
      ],
    {% endunless %}
  {% endcapture %}
  {% assign schema_start = product_schema | slice: 0 %}
  {% if schema_start == '{' %}
    {% assign product_schema = product_schema | remove_first: '{' | prepend: review_properties | prepend: '{' %}
  {% endif %}
{% endif %}
<script type="application/ld+json">{{ product_schema }}</script>

{% style %}
  .bns-product-reviews__list { display: grid; gap: 12px; padding: 0; list-style: none; }
  .bns-product-reviews__list li { padding: 14px; border: 1px solid #dce5ed; border-radius: 8px; }
  .bns-product-reviews__list p { margin: 8px 0 0; }
  .bns-product-reviews__form { display: grid; gap: 8px; max-width: 560px; margin-top: 24px; }
  .bns-product-reviews__form :is(input:not([type="hidden"]), select, textarea) { width: 100%; min-height: 44px; padding: 8px 12px; }
  .bns-product-reviews__form .button { justify-self: start; min-height: 44px; }
{% endstyle %}
{% stylesheet %}
.product-detail-info.wholesale-off .sp-wholesale-card,
.product-detail-info.wholesale-off .sp-wholesale-qty-note{display:none!important}
.product-detail-info.wholesale-merged .sp-wholesale-card{display:none!important}
.product-detail-price .sp-wholesale-qty-note{grid-column:2;margin:0;font-size:12px;color:#627582}
.price.is-wholesale .price-wholesale-tag{font-size:11px;font-weight:600;line-height:1.5;color:#123f5f;background:#e8f1f7;border-radius:999px;padding:2px 10px}
.catalog-refresh .product-detail-info .product-app-blocks{margin:0 0 14px}
.catalog-refresh .product-detail-info .product-app-blocks .mprfq-add-to-quote-button-pdp{box-sizing:border-box;width:100%;min-height:44px;font-weight:600}
{% endstylesheet %}
{% schema %}
{
  "name": "Main Product",
  "settings": [
    { "type": "checkbox", "id": "show_vendor", "label": "Tampilkan merek", "default": true },
    { "type": "checkbox", "id": "bulk_order", "label": "Pemesanan banyak varian", "default": true }
  ],
  "blocks": [
    { "type": "@app" },
    { "type": "text", "name": "Teks", "settings": [{ "type": "richtext", "id": "text", "label": "Isi", "default": "<p>Pastikan ukuran dan varian yang dipilih sudah sesuai.</p>" }] },
    { "type": "accordion", "name": "Accordion", "settings": [
      { "type": "text", "id": "heading", "label": "Judul", "default": "Informasi pengiriman" },
      { "type": "richtext", "id": "text", "label": "Isi" },
      { "type": "page", "id": "page", "label": "Halaman" }
    ] }
  ]
}
{% endschema %}
