<section class="section wrap product-root" data-product-root data-section-id="{{ section.id }}" data-product-url="{{ product.url }}"><nav class="breadcrumbs" aria-label="{{ 'general.menu' | t }}"><a href="{{ routes.root_url }}">{{ 'general.home' | t }}</a><span>/</span><a href="{{ routes.all_products_collection_url }}">{{ 'general.collections' | t }}</a><span>/</span><span>{{ product.title | escape }}</span></nav><div class="product-layout"><div class="product-gallery"><div class="gallery-main" data-gallery-main>{% assign selected_media = product.selected_or_first_available_variant.featured_media | default: product.featured_media %}{% for media in product.media %}<div class="gallery-item{% if media.id == selected_media.id %} is-active{% endif %}" data-media-id="{{ media.id }}">{% case media.media_type %}{% when 'image' %}<button type="button" class="zoom-trigger" data-zoom="{{ media | image_url: width: 2000 }}" aria-label="{{ 'general.zoom' | t }}">{{ media | image_url: width: 1400 | image_tag: loading: 'eager', widths: '400, 700, 1000, 1400', sizes: '(min-width:990px) 55vw, 100vw' }}</button>{% when 'video' %}{{ media | video_tag: controls: true, image_size: '1000x', preload: 'metadata' }}{% when 'external_video' %}{{ media | external_video_tag }}{% when 'model' %}{{ media | model_viewer_tag: reveal: 'interaction', toggleable: true }}{% endcase %}</div>{% else %}{{ 'product-1' | placeholder_svg_tag: 'placeholder' }}{% endfor %}</div>{% if product.media.size > 1 %}<p class="gallery-count" aria-hidden="true">{{ product.media.size }} foto / video</p><div class="gallery-thumbs">{% for media in product.media %}<button type="button" data-gallery-select="{{ media.id }}" aria-label="{{ 'product.media' | t }} {{ forloop.index }}"{% if media.id == selected_media.id %} aria-pressed="true"{% else %} aria-pressed="false"{% endif %}>{{ media.preview_image | image_url: width: 180 | image_tag: loading: 'lazy', widths: '90, 180', sizes: '80px' }}</button>{% endfor %}</div>{% endif %}</div>
<div class="product-info">{% if section.settings.show_vendor %}<p class="eyebrow">{{ product.vendor | escape }}</p>{% endif %}<h1>{{ product.title | escape }}</h1>{% assign v = product.selected_or_first_available_variant %}{% if v != blank %}{% render 'price', product: product, variant: v %}{% else %}<p class="price">{{ 'product.unavailable' | t }}</p>{% endif %}{% if v.sku != blank %}<p class="product-sku">{{ 'product.sku' | t }}: {{ v.sku | escape }}</p>{% endif %}
{% if v.available and v.inventory_management != blank and v.inventory_policy == 'deny' %}<p class="stock-status">{{ 'product.stock' | t: count: v.inventory_quantity }}</p>{% endif %}{% render 'product-form', product: product, section_id: section.id %}
<div class="product-benefits" aria-label="Keunggulan belanja">
  <div><strong>Pengiriman nasional</strong><span>Dikirim ke seluruh Indonesia</span></div>
  <div><strong>Dukungan BNS</strong><span>Bantuan sebelum dan sesudah belanja</span></div>
  <div><strong>Produk terpilih</strong><span>Spesifikasi jelas untuk perlengkapanmu</span></div>
</div>
{% render 'shopping-actions', product: product %}
{% render 'tool-product-data', product: product %}
{% render 'b2b-context' %}
{% if section.settings.bulk_order %}{% render 'bulk-order', product: product, section_id: section.id %}{% endif %}
{% for block in section.blocks %}{% case block.type %}{% when '@app' %}{% render block %}{% when 'text' %}<div class="rte product-extra" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>{% when 'accordion' %}<details class="product-accordion" {{ block.shopify_attributes }}><summary>{{ block.settings.heading | escape }}{% render 'icon', name: 'plus' %}</summary><div class="rte">{{ block.settings.text }}{{ block.settings.page.content }}</div></details>{% endcase %}{% endfor %}
<details class="product-accordion" open><summary>{{ 'product.description' | t }}{% render 'icon', name: 'plus' %}</summary><div class="rte">{{ product.description }}</div></details><div class="product-links"><button class="text-link" data-share="{{ shop.url }}{{ product.url }}">{{ 'general.share' | t }} ↗</button><a class="text-link quick-details-link" href="{{ product.url }}">{{ 'product.details' | t }} →</a></div></div></div></section>
<script type="application/ld+json">{{ product | structured_data }}</script>
{% schema %}
{
  "name": "Main Product",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Tampilkan merek",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "bulk_order",
      "label": "Pemesanan banyak varian",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "text",
      "name": "Teks",
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "Isi",
          "default": "<p>Pastikan ukuran dan varian yang dipilih sudah sesuai.</p>"
        }
      ]
    },
    {
      "type": "accordion",
      "name": "Accordion",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Judul",
          "default": "Informasi pengiriman"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Isi"
        },
        {
          "type": "page",
          "id": "page",
          "label": "Halaman"
        }
      ]
    }
  ]
}
{% endschema %}
