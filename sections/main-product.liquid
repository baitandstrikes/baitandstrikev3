{% assign v = product.selected_or_first_available_variant %}
<section class="section wrap product-root product-detail-catalog" data-product-root data-section-id="{{ section.id }}" data-product-url="{{ product.url }}">
  <nav class="breadcrumbs" aria-label="{{ 'general.menu' | t }}">
    <a href="{{ routes.root_url }}">{{ 'general.home' | t }}</a><span>/</span>
    <a href="{{ routes.all_products_collection_url }}">Produk</a><span>/</span>
    <span>{{ product.title | escape }}</span>
  </nav>

  <header class="product-detail-heading">
    <div>
      <h1>{{ product.title | escape }}</h1>
      <p>#Grup produk {{ product.id }}</p>
    </div>
    <button class="text-link" type="button" data-share="{{ shop.url }}{{ product.url }}">Bagikan ↗</button>
  </header>

  <div class="product-layout product-detail-layout">
    <div class="product-gallery">
      <div class="gallery-main" data-gallery-main>
        {% assign selected_media = v.featured_media | default: product.featured_media %}
        {% for media in product.media %}
          <div class="gallery-item{% if media.id == selected_media.id %} is-active{% endif %}" data-media-id="{{ media.id }}">
            {% case media.media_type %}
              {% when 'image' %}<button type="button" class="zoom-trigger" data-zoom="{{ media | image_url: width: 2000 }}" aria-label="{{ 'general.zoom' | t }}">{{ media | image_url: width: 1400 | image_tag: loading: 'eager', widths: '400, 700, 1000, 1400', sizes: '(min-width:990px) 44vw, 100vw' }}</button>
              {% when 'video' %}{{ media | video_tag: controls: true, image_size: '1000x', preload: 'metadata' }}
              {% when 'external_video' %}{{ media | external_video_tag }}
              {% when 'model' %}{{ media | model_viewer_tag: reveal: 'interaction', toggleable: true }}
            {% endcase %}
          </div>
        {% else %}
          {{ 'product-1' | placeholder_svg_tag: 'placeholder' }}
        {% endfor %}
      </div>
      {% if product.media.size > 1 %}
        <p class="gallery-count" aria-hidden="true">{{ product.media.size }} foto / video</p>
        <div class="gallery-thumbs">
          {% for media in product.media %}<button type="button" data-gallery-select="{{ media.id }}" aria-label="{{ 'product.media' | t }} {{ forloop.index }}" aria-pressed="{% if media.id == selected_media.id %}true{% else %}false{% endif %}">{{ media.preview_image | image_url: width: 180 | image_tag: loading: 'lazy', widths: '90, 180', sizes: '72px' }}</button>{% endfor %}
        </div>
      {% endif %}
    </div>

    <div class="product-info product-detail-info">
      <div class="product-detail-summary">
        {% if section.settings.show_vendor and product.vendor != blank %}<div class="product-detail-row"><span>Merek</span><strong><a href="{{ routes.search_url }}?q={{ product.vendor | url_encode }}">{{ product.vendor | escape }}</a></strong></div>{% endif %}
        <div class="product-detail-row product-detail-price"><span>Harga</span>{% if v != blank %}{% render 'price', product: product, variant: v %}{% else %}<p class="price">{{ 'product.unavailable' | t }}</p>{% endif %}</div>
        <div class="product-detail-row"><span>Ketersediaan</span><strong class="product-detail-stock{% unless v.available %} is-sold-out{% endunless %}">{% if v.available %}Ready Stock{% else %}Stok Habis{% endif %}</strong></div>
        <div class="product-detail-row"><span>SKU</span><strong class="product-sku">{% if v.sku != blank %}{{ v.sku | escape }}{% else %}-{% endif %}</strong></div>
      </div>

      {% render 'product-form', product: product, section_id: section.id %}

      <div class="product-detail-assurance">
        <div><strong>Produk resmi BAIT&amp;STRIKE</strong><span>Produk terpilih dengan informasi yang jelas.</span></div>
        <div><strong>Pengiriman seluruh Indonesia</strong><span>Estimasi pengiriman tampil saat checkout.</span></div>
      </div>

      <div class="product-detail-specs">
        <h2>Spesifikasi</h2>
        <dl>
          {% if product.vendor != blank %}<div><dt>Merek</dt><dd>{{ product.vendor | escape }}</dd></div>{% endif %}
          {% for option in product.options_with_values %}<div><dt>{{ option.name | escape }}</dt><dd>{{ option.values | map: 'name' | join: ', ' | default: option.values | join: ', ' }}</dd></div>{% endfor %}
          <div><dt>Pilihan produk</dt><dd>{{ product.variants.size }} varian</dd></div>
        </dl>
      </div>

      {% render 'tool-product-data', product: product %}
      {% render 'b2b-context' %}
    </div>
  </div>

  {% if section.settings.bulk_order %}{% render 'bulk-order', product: product, section_id: section.id %}{% endif %}

  <section class="product-information-catalog" aria-labelledby="information-heading-{{ section.id }}">
    <h2 id="information-heading-{{ section.id }}">Informasi Produk</h2>
    <div class="rte">{{ product.description }}</div>
  </section>

  <div class="product-detail-extras">
    {% for block in section.blocks %}
      {% case block.type %}
        {% when '@app' %}{% render block %}
        {% when 'text' %}<div class="rte product-extra" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
        {% when 'accordion' %}<details class="product-accordion" {{ block.shopify_attributes }}><summary>{{ block.settings.heading | escape }}{% render 'icon', name: 'plus' %}</summary><div class="rte">{{ block.settings.text }}{{ block.settings.page.content }}</div></details>
      {% endcase %}
    {% endfor %}
  </div>
</section>
<script type="application/ld+json">{{ product | structured_data }}</script>
{% schema %}
{
  "name": "Main Product",
  "settings": [
    { "type": "checkbox", "id": "show_vendor", "label": "Tampilkan merek", "default": true },
    { "type": "checkbox", "id": "bulk_order", "label": "Pemesanan banyak varian", "default": true }
  ],
  "blocks": [
    { "type": "@app" },
    { "type": "text", "name": "Teks", "settings": [{ "type": "richtext", "id": "text", "label": "Isi", "default": "<p>Pastikan ukuran dan varian yang dipilih sudah sesuai.</p>" }] },
    { "type": "accordion", "name": "Accordion", "settings": [
      { "type": "text", "id": "heading", "label": "Judul", "default": "Informasi pengiriman" },
      { "type": "richtext", "id": "text", "label": "Isi" },
      { "type": "page", "id": "page", "label": "Halaman" }
    ] }
  ]
}
{% endschema %}
