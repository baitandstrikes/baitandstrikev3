{{ 'faq.css' | asset_url | stylesheet_tag }}
<section class="section wrap faq reveal" aria-labelledby="FaqTitle-{{ section.id }}">
  <div class="faq-hero">
    <div class="faq-hero__content">
      <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
      <h1 id="FaqTitle-{{ section.id }}">{{ section.settings.title | escape }}</h1>
      {% if section.settings.subtitle != blank %}
        <p>{{ section.settings.subtitle | escape }}</p>
      {% endif %}
      <a class="faq-hero__link" href="#FaqQuestions-{{ section.id }}">Jelajahi pertanyaan <span aria-hidden="true">↓</span></a>
    </div>
    <div class="faq-hero__media">
      <img src="{{ 'category-bait-photo-v2.png' | asset_url }}" width="1080" height="1080" loading="eager" fetchpriority="high" alt="">
      <span class="faq-hero__badge"><span aria-hidden="true">?</span> Kami siap membantu</span>
    </div>
  </div>

  <div class="faq-content" id="FaqQuestions-{{ section.id }}">
    <div class="faq-content__heading">
      <p class="eyebrow">PUSAT BANTUAN</p>
      <h2>Jawaban untuk mulai memancing dengan yakin.</h2>
      <p>Pilih pertanyaan untuk melihat informasi selengkapnya.</p>
    </div>
    <div class="faq-list">
      {% for block in section.blocks %}
        <details class="faq-item" {{ block.shopify_attributes }}>
          <summary>
            <span class="faq-number">{% if forloop.index < 10 %}0{% endif %}{{ forloop.index }}</span>
            <span class="faq-question">{{ block.settings.question | escape }}</span>
            <span class="faq-toggle" aria-hidden="true">{% render 'icon', name: 'plus' %}</span>
          </summary>
          <div class="rte faq-answer">{{ block.settings.answer }}</div>
        </details>
      {% endfor %}
    </div>
  </div>

  {% if section.settings.contact_title != blank %}
    <div class="faq-contact">
      <div class="faq-contact__icon" aria-hidden="true">?</div>
      <div class="faq-contact__copy">
        <p class="eyebrow">BUTUH BANTUAN LANGSUNG?</p>
        <h2>{{ section.settings.contact_title | escape }}</h2>
        <p>{{ section.settings.contact_text | escape }}</p>
      </div>
      {% if section.settings.contact_link != blank %}
        <a class="button" href="{{ section.settings.contact_link }}" target="_blank" rel="noopener noreferrer">
          {{ section.settings.contact_button | escape }} <span aria-hidden="true">→</span>
        </a>
      {% endif %}
    </div>
  {% endif %}
</section>
{% schema %}
{
  "name": "Faq",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Teks kecil",
      "default": "BANTUAN"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Judul",
      "default": "Pertanyaan yang sering ditanyakan"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Pengantar"
    },
    {
      "type": "text",
      "id": "contact_title",
      "label": "Judul bantuan"
    },
    {
      "type": "textarea",
      "id": "contact_text",
      "label": "Teks bantuan"
    },
    {
      "type": "text",
      "id": "contact_button",
      "label": "Tombol bantuan"
    },
    {
      "type": "url",
      "id": "contact_link",
      "label": "Tautan bantuan"
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Pertanyaan",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Pertanyaan",
          "default": "Bagaimana cara memesan?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Jawaban",
          "default": "<p>Pilih produk dan varian, masukkan ke keranjang, lalu lanjutkan checkout.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Faq"
    }
  ]
}
{% endschema %}
