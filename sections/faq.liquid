{{ 'faq.css' | asset_url | stylesheet_tag }}
<section class="section wrap faq reveal" aria-labelledby="FaqTitle-{{ section.id }}">
  <div class="faq-hero">
    <div class="faq-hero__content">
      <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
      <h1 id="FaqTitle-{{ section.id }}">{{ section.settings.title | escape }}</h1>
      {% if section.settings.subtitle != blank %}
        <p>{{ section.settings.subtitle | escape }}</p>
      {% endif %}
      <a class="faq-hero__link" href="#FaqQuestions-{{ section.id }}">Jelajahi pertanyaan <span aria-hidden="true">↓</span></a>
    </div>
    <div class="faq-hero__media">
      <img src="https://cdn.shopify.com/s/files/1/0838/8824/2905/files/bns-faq-hero.png?v=1795169991" width="1254" height="1254" loading="eager" fetchpriority="high" alt="">
      <span class="faq-hero__badge"><span aria-hidden="true">?</span> Kami siap membantu</span>
    </div>
  </div>

  <div class="faq-content" id="FaqQuestions-{{ section.id }}">
    <div class="faq-content__heading">
      <p class="eyebrow">PUSAT BANTUAN</p>
      <h2>Jawaban untuk mulai memancing dengan yakin.</h2>
      <p>Pilih pertanyaan untuk melihat informasi selengkapnya.</p>
    </div>
    {% assign topic_ids = 'pesanan|pengiriman|pembayaran|retur|b2b|akun' | split: '|' %}
    {% assign topic_labels = 'Pesanan & stok|Pengiriman|Pembayaran|Retur, garansi & klaim|B2B & quotation|Akun & privasi' | split: '|' %}
    {% capture topic_links %}{% endcapture %}
    {% capture topic_sections %}{% endcapture %}
    {% for topic_id in topic_ids %}
      {% assign topic_label = topic_labels[forloop.index0] %}
      {% assign topic_anchor = 'FaqTopic-' | append: section.id | append: '-' | append: topic_id %}
      {% assign question_count = 0 %}
      {% capture questions %}
        {% for block in section.blocks %}
          {% assign block_topic = block.settings.topic | default: 'pesanan' %}
          {% if block_topic != topic_id %}{% continue %}{% endif %}
          {% assign question_count = question_count | plus: 1 %}
          <details class="faq-item" {{ block.shopify_attributes }}>
            <summary>
              <span class="faq-number" aria-hidden="true">{% if question_count < 10 %}0{% endif %}{{ question_count }}</span>
              <span class="faq-question">{{ block.settings.question | escape }}</span>
              <span class="faq-toggle" aria-hidden="true">{% render 'icon', name: 'plus' %}</span>
            </summary>
            <div class="rte faq-answer">{{ block.settings.answer }}</div>
          </details>
        {% endfor %}
      {% endcapture %}
      {% if question_count > 0 %}
        {% capture topic_links %}{{ topic_links }}<a href="#{{ topic_anchor }}">{{ topic_label | escape }}</a>{% endcapture %}
        {% capture topic_sections %}
          {{ topic_sections }}
          <section class="faq-topic" id="{{ topic_anchor }}" aria-labelledby="{{ topic_anchor }}-heading">
            <h3 id="{{ topic_anchor }}-heading">{{ topic_label | escape }}</h3>
            <div class="faq-list">{{ questions }}</div>
          </section>
        {% endcapture %}
      {% endif %}
    {% endfor %}
    {% if topic_sections != blank %}
      <div class="faq-topics">
        <nav class="faq-topic-nav" aria-label="Topik FAQ">
          <h3>Topik</h3>
          {{ topic_links }}
        </nav>
        <div>{{ topic_sections }}</div>
      </div>
    {% endif %}
  </div>

  {% if section.settings.contact_title != blank %}
    <div class="faq-contact">
      <div class="faq-contact__icon" aria-hidden="true">?</div>
      <div class="faq-contact__copy">
        <p class="eyebrow">BUTUH BANTUAN LANGSUNG?</p>
        <h2>{{ section.settings.contact_title | escape }}</h2>
        <p>{{ section.settings.contact_text | escape }}</p>
      </div>
      {% if section.settings.contact_link != blank %}
        <a class="button" href="{{ section.settings.contact_link }}" target="_blank" rel="noopener noreferrer">
          {{ section.settings.contact_button | escape }} <span aria-hidden="true">→</span>
        </a>
      {% endif %}
    </div>
  {% endif %}
</section>
{% schema %}
{
  "name": "Faq",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Teks kecil",
      "default": "BANTUAN"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Judul",
      "default": "Pertanyaan yang sering ditanyakan"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Pengantar"
    },
    {
      "type": "text",
      "id": "contact_title",
      "label": "Judul bantuan"
    },
    {
      "type": "textarea",
      "id": "contact_text",
      "label": "Teks bantuan"
    },
    {
      "type": "text",
      "id": "contact_button",
      "label": "Tombol bantuan"
    },
    {
      "type": "url",
      "id": "contact_link",
      "label": "Tautan bantuan"
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Pertanyaan",
      "settings": [
        {"type":"select","id":"topic","label":"Topik","options":[{"value":"pesanan","label":"Pesanan & stok"},{"value":"pengiriman","label":"Pengiriman"},{"value":"pembayaran","label":"Pembayaran"},{"value":"retur","label":"Retur, garansi & klaim"},{"value":"b2b","label":"B2B & quotation"},{"value":"akun","label":"Akun & privasi"}],"default":"pesanan"},
        {
          "type": "text",
          "id": "question",
          "label": "Pertanyaan",
          "default": "Bagaimana cara memesan?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Jawaban",
          "default": "<p>Pilih produk dan varian, masukkan ke keranjang, lalu lanjutkan checkout.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Faq"
    }
  ]
}
{% endschema %}
