<section class="recently-viewed wrap" data-recently-viewed hidden aria-labelledby="RecentlyViewedTitle-{{ section.id }}">
  <div class="recently-viewed__heading"><div><span>RIWAYAT BELANJA</span><h2 id="RecentlyViewedTitle-{{ section.id }}">{{ section.settings.title | escape }}</h2></div><button type="button" data-recent-clear>{{ section.settings.clear_label | escape }}</button></div>
  <div class="recently-viewed__track" data-recent-track></div>
</section>
{% stylesheet %}
.recently-viewed{padding:24px 0}.recently-viewed__heading{display:flex;justify-content:space-between;align-items:end;margin-bottom:12px}.recently-viewed__heading span{font-size:10px;font-weight:700;letter-spacing:.12em;color:#667680}.recently-viewed__heading h2{font-size:22px;font-weight:700;margin:2px 0 0}.recently-viewed__heading button{border:0;background:transparent;color:#1269a0;font-size:11px;text-decoration:underline}.recently-viewed__track{display:grid;grid-auto-flow:column;grid-auto-columns:minmax(260px,1fr);overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none;border:1px solid #e1e5e7;background:#fff}.recently-viewed__card{scroll-snap-align:start;display:grid;grid-template-columns:92px minmax(0,1fr);grid-template-rows:auto auto auto;gap:2px 10px;min-width:260px;padding:12px;border-right:1px solid #e1e5e7}.recently-viewed__card img{grid-row:1/4;width:88px;height:88px;object-fit:contain}.recently-viewed__card strong{font-size:12px;line-height:1.3;max-height:2.6em;overflow:hidden}.recently-viewed__card span{font-size:10px;color:#68757d}.recently-viewed__card em{font-size:12px;color:#d7271c;font-style:normal;font-weight:700}@media(max-width:749px){.recently-viewed{width:100%;padding:18px 10px}.recently-viewed__heading h2{font-size:18px}.recently-viewed__track{grid-auto-columns:82vw}.recently-viewed__card{min-width:0}}
{% endstylesheet %}
{% schema %}
{"name":"Recently Viewed","settings":[{"type":"text","id":"title","label":"Judul","default":"Terakhir dilihat"},{"type":"text","id":"clear_label","label":"Hapus riwayat","default":"Hapus riwayat"}],"presets":[{"name":"Recently Viewed"}]}
{% endschema %}
