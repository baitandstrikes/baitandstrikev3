<section class="recently-viewed" data-recently-viewed hidden aria-labelledby="RecentlyViewedTitle-{{ section.id }}">
  <div class="wrap catalog-body__inner recently-viewed__panel">
    <div class="recently-viewed__heading"><div><span>RIWAYAT BELANJA</span><h2 id="RecentlyViewedTitle-{{ section.id }}">{{ section.settings.title | escape }}</h2></div><button type="button" data-recent-clear>{{ section.settings.clear_label | escape }}</button></div>
    <div class="recently-viewed__track" data-recent-track></div>
  </div>
</section>
{% stylesheet %}
.recently-viewed{width:100%;padding:24px 0;background:#f3f4f5}.recently-viewed__panel{box-sizing:border-box;background:#fff;border:1px solid #dfe3e5;border-radius:6px;padding:18px 20px}.recently-viewed__heading{display:flex;justify-content:space-between;align-items:end;margin-bottom:12px}.recently-viewed__heading span{font-size:10px;font-weight:700;letter-spacing:.12em;color:#667680}.recently-viewed__heading h2{font-size:22px;font-weight:700;margin:2px 0 0}.recently-viewed__heading button{border:0;background:transparent;color:#1269a0;font-size:11px;text-decoration:underline}.recently-viewed__track{display:grid;grid-auto-flow:column;grid-auto-columns:minmax(260px,calc((100% - 36px)/4));gap:12px;overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none}.recently-viewed__track:not(:has(> .recently-viewed__card:nth-child(5))){grid-auto-flow:row;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));grid-auto-columns:unset;overflow:visible}.recently-viewed__card{scroll-snap-align:start;display:grid;grid-template-columns:92px minmax(0,1fr);grid-template-rows:auto auto auto;gap:2px 10px;min-width:0;padding:12px;border:1px solid #e1e5e7;border-radius:8px;background:#fff}.recently-viewed__card img{grid-row:1/4;width:88px;height:88px;object-fit:contain}.recently-viewed__card strong{font-size:12px;line-height:1.3;max-height:2.6em;overflow:hidden}.recently-viewed__card span{font-size:10px;color:#68757d}.recently-viewed__card em{font-size:12px;color:#d7271c;font-style:normal;font-weight:700}@media(max-width:749px){.recently-viewed{padding:14px 0;background:#f4f6f8}.recently-viewed__panel{padding:14px 12px;background:#fff;border:1px solid #dfe5e9;border-radius:6px}.recently-viewed__heading{align-items:center;margin-bottom:10px}.recently-viewed__heading span{font-size:9px}.recently-viewed__heading h2{font-size:18px}.recently-viewed__heading button{font-size:10px}.recently-viewed__track{grid-auto-columns:100%;grid-template-columns:none;grid-auto-flow:column;gap:8px;overflow-x:auto;overscroll-behavior-x:contain}.recently-viewed__card{min-width:0;grid-template-columns:72px minmax(0,1fr);gap:2px 9px;padding:9px}.recently-viewed__card img{width:68px;height:68px}.recently-viewed__card strong{font-size:11px}.recently-viewed__card em{font-size:12px}}.recently-viewed__track:has(> .recently-viewed__card:only-child){grid-auto-columns:100%}
{% endstylesheet %}
{% schema %}
{"name":"Recently Viewed","settings":[{"type":"text","id":"title","label":"Judul","default":"Terakhir dilihat"},{"type":"text","id":"clear_label","label":"Hapus riwayat","default":"Hapus riwayat"}],"presets":[{"name":"Recently Viewed"}]}
{% endschema %}
