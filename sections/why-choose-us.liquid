<section class="bns-why section reveal" aria-labelledby="BNSWhyTitle-{{ section.id }}">
  <div class="wrap">
    <div class="bns-why__heading">
      {% if section.settings.eyebrow != blank %}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
      <h2 id="BNSWhyTitle-{{ section.id }}">{{ section.settings.title | escape }}</h2>
      {% if section.settings.intro != blank %}<div class="rte">{{ section.settings.intro }}</div>{% endif %}
    </div>
    <div class="bns-why__grid">
      {% for block in section.blocks %}
        <article class="bns-why__item" {{ block.shopify_attributes }}>
          <span class="bns-why__icon" aria-hidden="true">{{ block.settings.icon | escape }}</span>
          <div><h3>{{ block.settings.title | escape }}</h3><p>{{ block.settings.text | escape }}</p></div>
        </article>
      {% endfor %}
    </div>
  </div>
</section>
{% stylesheet %}
.bns-why{padding:clamp(48px,6vw,80px) 0;background:#3282c0;color:#fff}
.bns-why__heading{max-width:740px;text-align:center;margin:0 auto 42px}
.bns-why__heading h2{font-size:clamp(30px,4vw,46px);line-height:1.12;margin:8px 0 14px}
.bns-why__heading .rte{color:#e4f2fc}
.bns-why__grid{max-width:1250px;margin:auto;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:32px 38px}
.bns-why__item{display:flex;align-items:flex-start;gap:17px;transition:transform .55s cubic-bezier(.22,.61,.36,1)}
.bns-why__item:hover{transform:translateY(-4px)}
.bns-why__icon{flex:0 0 54px;width:54px;height:54px;border-radius:50%;display:grid;place-items:center;background:#ffffff24;font-size:25px}
.bns-why__item h3{margin:2px 0 8px;font-size:18px;line-height:1.3;color:#fff}
.bns-why__item p{margin:0;color:#e4f2fc;font-size:14px;line-height:1.7}
@media(max-width:900px){.bns-why__grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:26px}}
@media(max-width:600px){.bns-why__heading{text-align:left;margin-bottom:28px}.bns-why__grid{grid-template-columns:1fr;gap:23px}.bns-why__item{gap:14px}.bns-why__icon{flex-basis:48px;width:48px;height:48px;font-size:22px}}
@media(prefers-reduced-motion:reduce){.bns-why__item{transition:none}}
{% endstylesheet %}
{% schema %}
{
  "name":"Why Choose Us",
  "settings":[
    {"type":"text","id":"eyebrow","label":"Label kecil","default":"KENAPA BAIT&STRIKE"},
    {"type":"text","id":"title","label":"Judul","default":"Why Choose Us"},
    {"type":"richtext","id":"intro","label":"Pengantar","default":"<p>Kami membantu pemancing menemukan perlengkapan yang tepat, dengan informasi produk yang jelas dan pilihan untuk kebutuhan personal maupun bisnis.</p>"}
  ],
  "blocks":[
    {"type":"benefit","name":"Keunggulan","settings":[
      {"type":"text","id":"icon","label":"Ikon / Emoji","default":"🎣"},
      {"type":"text","id":"title","label":"Judul","default":"Pilihan perlengkapan terkurasi"},
      {"type":"textarea","id":"text","label":"Deskripsi","default":"Pilihan gear untuk berbagai teknik dan kebutuhan memancing."}
    ]}
  ],
  "presets":[
    {"name":"Why Choose Us","blocks":[
      {"type":"benefit","settings":{"icon":"🎣","title":"Pilihan untuk Berbagai Teknik","text":"Jelajahi perlengkapan untuk berbagai gaya, target ikan, dan kondisi spot."}},
      {"type":"benefit","settings":{"icon":"🔎","title":"Informasi Produk Jelas","text":"Detail dan varian membantu kamu menentukan pilihan sebelum membeli."}},
      {"type":"benefit","settings":{"icon":"🤝","title":"Dukungan untuk Mitra","text":"Ada jalur pendaftaran untuk toko, reseller, dan kebutuhan bisnis."}},
      {"type":"benefit","settings":{"icon":"📦","title":"Proses Pesanan Praktis","text":"Katalog dan keranjang membantu proses belanja tetap teratur."}},
      {"type":"benefit","settings":{"icon":"💙","title":"Komunitas Angler","text":"Kami hadir untuk mendukung semangat dan pengalaman memancing."}},
      {"type":"benefit","settings":{"icon":"⭐","title":"Fokus pada Kebutuhan Angler","text":"Kami terus membangun pengalaman belanja yang relevan untuk pemancing."}}
    ]}
  ]
}
{% endschema %}
