<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="theme-color" content="{{ settings.color_accent }}">
<title>{{ page_title }}{% unless page_title contains shop.name %} — {{ shop.name }}{% endunless %}</title>
{% if page_description %}<meta name="description" content="{{ page_description | escape }}">{% endif %}
<link rel="canonical" href="{{ canonical_url }}">
{% if settings.favicon %}<link rel="icon" href="{{ settings.favicon | image_url: width: 32 }}">{% endif %}
<meta property="og:title" content="{{ page_title | escape }}"><meta property="og:url" content="{{ canonical_url }}"><meta property="og:site_name" content="{{ shop.name | escape }}"><meta property="og:description" content="{{ page_description | default: shop.description | escape }}"><meta property="og:type" content="{% if request.page_type == 'product' %}product{% else %}website{% endif %}">
{% if page_image %}<meta property="og:image" content="https:{{ page_image | image_url: width: 1200 }}">{% endif %}
{{ content_for_header }}
{% style %}
{{ settings.body_font | font_face: font_display: 'swap' }}
{{ settings.heading_font | font_face: font_display: 'swap' }}
:root{--accent:{{ settings.color_accent }};--yellow:{{ settings.color_secondary }};--ink:{{ settings.color_text }};--paper:{{ settings.color_background }};--page-width:{{ settings.page_width }}px;--body-font:{{ settings.body_font.family }},{{ settings.body_font.fallback_families }};--heading-font:{{ settings.heading_font.family }},{{ settings.heading_font.fallback_families }}}
{% endstyle %}
{{ 'bns.css' | asset_url | stylesheet_tag }}
{{ 'symmetry-inspired.css' | asset_url | stylesheet_tag }}
{{ 'fishing-filters-mobile.css' | asset_url | stylesheet_tag }}
<script src="{{ 'bns.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'recently-viewed.js' | asset_url }}" defer="defer"></script>
<script type="application/json" id="bns-config">{"bulkEmpty":{{ 'b2b.empty' | t | json }},"bulkInvalid":{{ 'b2b.invalid' | t | json }},"predictive":{{ routes.predictive_search_url | json }},"root":{{ routes.root_url | json }},"cart":{{ routes.cart_url | json }},"add":{{ routes.cart_add_url | append: '.js' | json }},"change":{{ routes.cart_change_url | append: '.js' | json }},"error":{{ 'general.error' | t | json }},"loading":{{ 'general.loading' | t | json }},"added":{{ 'cart.added' | t | json }},"copied":{{ 'general.copied' | t | json }},"deleteConfirm":{{ 'customer.delete_confirm' | t | json }}}</script>
<script src="{{ 'discovery.js' | asset_url }}" defer></script>
<script src="{{ 'bulk-order.js' | asset_url }}" defer></script>
<script type="application/json" id="fishing-discovery-labels">{"grid_view":{{ 'discovery.grid_view' | t | json }},"one_column":{{ 'discovery.one_column' | t | json }},"two_columns":{{ 'discovery.two_columns' | t | json }},"filter":{{ 'discovery.filter' | t | json }},"close":{{ 'discovery.close' | t | json }},"show_results":{{ 'discovery.show_results' | t | json }},"remove_filter":{{ 'discovery.remove_filter' | t | json }},"active_filters":{{ 'discovery.active_filters' | t | json }},"specifications":{{ 'discovery.specifications' | t | json }},"other_options":{{ 'discovery.other_options' | t | json }},"action":{{ 'tools.action' | t | json }},"line_weight":{{ 'tools.line_weight' | t | json }},"pe":{{ 'tools.pe' | t | json }},"ratio":{{ 'tools.ratio' | t | json }},"drag":{{ 'tools.drag' | t | json }},"diameter":{{ 'tools.diameter' | t | json }},"size":{{ 'tools.size' | t | json }},"length":{{ 'discovery.length' | t | json }},"weight":{{ 'discovery.weight' | t | json }},"brand":{{ 'discovery.brand' | t | json }},"hint":{{ 'discovery.filter_hint' | t | json }},"loading":{{ 'discovery.loading' | t | json }},"error":{{ 'discovery.load_error' | t | json }},"all":{{ 'discovery.all' | t | json }},"reset":{{ 'discovery.reset' | t | json }},"results":{{ 'discovery.results' | t: count: 'COUNT' | json }},"empty":{{ 'discovery.empty' | t | json }},"previous":{{ 'discovery.previous' | t | json }},"next":{{ 'discovery.next' | t | json }}}</script>
<script src="{{ 'fishing-specs.js' | asset_url }}" defer></script>
<script src="{{ 'fishing-discovery.js' | asset_url }}" defer></script>
{{ 'shopping-tools.css' | asset_url | stylesheet_tag }}
{{ 'listing-colors.css' | asset_url | stylesheet_tag }}
<script src="{{ 'shopping-tools.js' | asset_url }}" defer></script>
{{ 'catalog-refresh.css' | asset_url | stylesheet_tag }}
{{ 'whatsapp-widget.css' | asset_url | stylesheet_tag }}
<script src="{{ 'whatsapp-widget.js' | asset_url }}" defer></script>
</head>
<body class="catalog-refresh page-{{ request.page_type }}{% if settings.animations %} motion-enabled{% endif %}"{% if product %} data-listing-color="{% if product.metafields.custom.listing_color.value != blank %}{{ product.metafields.custom.listing_color.value | color_to_hex | escape }}{% endif %}" data-listing-border-color="{% if product.metafields.custom.listing_border_color.value != blank %}{{ product.metafields.custom.listing_border_color.value | color_to_hex | escape }}{% endif %}" data-listing-badge="{{ product.metafields.custom.listing_badge.value | escape }}" data-listing-group="{{ product.metafields.custom.listing_group.value | escape }}" data-listing-variant-color="{% if product.selected_or_first_available_variant.metafields.custom.listing_color.value != blank %}{{ product.selected_or_first_available_variant.metafields.custom.listing_color.value | color_to_hex | escape }}{% endif %}" data-listing-variant-border-color="{% if product.selected_or_first_available_variant.metafields.custom.listing_border_color.value != blank %}{{ product.selected_or_first_available_variant.metafields.custom.listing_border_color.value | color_to_hex | escape }}{% endif %}" data-listing-variant-badge="{{ product.selected_or_first_available_variant.metafields.custom.listing_badge.value | escape }}" data-listing-enabled="{{ product.metafields.custom.listing_color_enabled.value }}"{% endif %}>
<a href="#MainContent" class="skip-link">{{ 'general.skip' | t }}</a>
{% sections 'header-group' %}
<main id="MainContent" tabindex="-1">{{ content_for_layout }}</main>
{% render 'shopping-tools' %}
{% sections 'footer-group' %}
{% section 'cart-drawer' %}
<dialog id="QuickView" class="quick-dialog" aria-label="{{ 'product.quick_view' | t }}"><button class="icon-button dialog-close" data-close-dialog aria-label="{{ 'general.close' | t }}">{% render 'icon', name: 'close' %}</button><div data-quick-content></div></dialog>
<dialog id="ImageZoom" class="zoom-dialog" aria-label="{{ 'general.zoom' | t }}"><button class="icon-button dialog-close" data-close-dialog aria-label="{{ 'general.close' | t }}">{% render 'icon', name: 'close' %}</button><img width="1800" height="1800" alt="" data-zoom-image></dialog>
<div id="BnsStatus" class="toast" role="status" aria-live="polite"></div>
<div class="whatsapp-widget" data-whatsapp-widget>
  <div class="whatsapp-widget__hint" data-whatsapp-hint>
    <strong>Butuh bantuan?</strong>
    <span>Tim CS siap membantu via WhatsApp</span>
    <button class="whatsapp-widget__dismiss" type="button" data-whatsapp-dismiss aria-label="Tutup pesan bantuan">&times;</button>
  </div>
  <a class="whatsapp-widget__link" href="https://wa.me/6287795361519" target="_blank" rel="noopener noreferrer" aria-label="Chat CS melalui WhatsApp">
    <span class="whatsapp-widget__icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" focusable="false">
        <path d="M20.1 11.8a8.2 8.2 0 0 1-12 7.2L3 20l1-4.8a8.2 8.2 0 1 1 16.1-3.4Z"></path>
        <path d="M8.3 7.8c.2-.5.5-.6.8-.6h.4c.2 0 .4.1.5.4l.8 1.8c.1.2.1.4-.1.6l-.6.7c-.2.2-.2.4-.1.6.4.8 1.2 1.5 2 1.9.2.1.4.1.6-.1l.7-.7c.2-.2.4-.2.6-.1l1.8.9c.2.1.3.3.3.5v.5c0 .3-.1.5-.5.7-.5.3-1.4.4-2.4 0-1.1-.4-2.3-1.3-3.3-2.3-1-1-1.9-2.3-2.3-3.4-.3-.9-.2-1.8.1-2.4Z"></path>
      </svg>
    </span>
    <span>Chat CS</span>
  </a>
</div>
</body></html>
